@page
@model MedicalDevicesModel
@using MomenMedmSys.Core.Entities
@{
    ViewData["Title"] = "Medical Devices";
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h1>@ViewData["Title"]</h1>

@await Html.PartialAsync("_PrintButton")

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Search devices..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<DeviceStatus>()">
                    <option value="">All Status</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="risk" class="form-select" asp-items="Html.GetEnumSelectList<RiskClass>()">
                    <option value="">All Risk</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentFilter == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filter</button>
                <a asp-page="MedicalDevices" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Medical Devices (@Model.DeviceList.Count)</h5>
        <a asp-page="/Admin/DeviceCreate" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Device</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Device Code</th>
                    <th>Device Name</th>
                    <th>Manufacturer</th>
                    <th>Category</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Risk</th>
                    <th>Purchase Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DeviceList.Any())
                {
                    foreach (var device in Model.DeviceList)
                    {
                        <tr>
                            <td><strong>@device.DeviceCode</strong></td>
                            <td>@device.DeviceName</td>
                            <td>@device.Manufacturer</td>
                            <td>@device.Category</td>
                            <td>@device.Department</td>
                            <td>
                                <span class="badge bg-@(device.Status.ToString() == "Active" ? "success" : device.Status.ToString() == "UnderMaintenance" ? "warning" : "secondary")">
                                    @device.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@(device.RiskClassification.ToString() == "Critical" ? "danger" : device.RiskClassification.ToString() == "High" ? "warning" : "info")">
                                    @device.RiskClassification
                                </span>
                            </td>
                            <td>@device.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <a asp-page="/Admin/DeviceEdit" asp-route-id="@device.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Admin/DeviceDetails" asp-route-id="@device.Id" class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-display display-6"></i>
                            <p class="lead mt-2">No medical devices found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <script>
      // Page-specific print options for Medical Devices
      function beforePrint() {
        // Optionally highlight specific sections or modify content before printing
        console.log('Preparing Medical Devices page for printing...');
      }
    </script>
}
