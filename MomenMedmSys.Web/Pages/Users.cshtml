@page
@model UsersModel
@{
    ViewData["Title"] = "Users Management";
}

<h1>@ViewData["Title"]</h1>

@await Html.PartialAsync("_PrintButton")

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <input type="text" name="search" class="form-control" placeholder="Search users by name, email, job title or department..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Search</button>
                <a asp-page="Users" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Staff Members (@Model.StaffList.Count)</h5>
        <a asp-page="/Admin/UserCreate" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add New User</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.StaffList.Any())
                {
                    foreach (var staff in Model.StaffList)
                    {
                        <tr>
                            <td><strong>@staff.EmployeeId</strong></td>
                            <td>@staff.FullName</td>
                            <td>@staff.Role</td>
                            <td>@staff.JobTitle</td>
                            <td>@staff.Department</td>
                            <td>@staff.Email</td>
                            <td>@staff.Phone</td>
                            <td>
                                <span class="badge @(staff.IsActive ? "bg-success" : "bg-secondary")">
                                    @(staff.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <a asp-page="/Admin/UserEdit" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Admin/UserDetails" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-people display-6"></i>
                            <p class="lead mt-2">No staff members found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
      function beforePrint() {
        console.log('Preparing Users page for printing...');
      }
    </script>
}
