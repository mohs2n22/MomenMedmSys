@page
@model AdminModel
@{
    ViewData["Title"] = "Admin Panel - Hospital Settings";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.MessageSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Hospital Settings</h5>
    </div>
    <div class="card-body">
        <form method="post" class="row g-3">
            <div class="col-md-6">
                <label asp-for="HospitalSettings.HospitalName" class="form-label">Hospital Name</label>
                <input asp-for="HospitalSettings.HospitalName" class="form-control" placeholder="Enter hospital name" />
                <span asp-validation-for="HospitalSettings.HospitalName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HospitalSettings.LogoPath" class="form-label">Logo Path (URL or relative path)</label>
                <input asp-for="HospitalSettings.LogoPath" class="form-control" placeholder="e.g., /images/logo.png or https://example.com/logo.png" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Settings</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.HospitalSettings.LogoPath))
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Logo Preview</h5>
        </div>
        <div class="card-body text-center">
            <img src="@Model.HospitalSettings.LogoPath" alt="Hospital Logo" style="max-height: 150px; max-width: 100%;" onerror="this.style.display='none'" />
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}