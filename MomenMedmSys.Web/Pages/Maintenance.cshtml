@page
@model MaintenanceModel
@{
    ViewData["Title"] = "Maintenance Records";
}

<h1>@ViewData["Title"]</h1>

@await Html.PartialAsync("_PrintButton")

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Scheduled" selected="@(Model.StatusFilter == "Scheduled")">Scheduled</option>
                    <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
            <div class="col-md-3">
                <a asp-page="/Admin/MaintenanceCreate" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Schedule Maintenance</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Maintenance Records (@Model.MaintenanceList.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Record ID</th>
                    <th>Device</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Cost</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MaintenanceList.Any())
                {
                    foreach (var record in Model.MaintenanceList)
                    {
                        var deviceName = Model.DeviceNames.ContainsKey(record.DeviceId) ? Model.DeviceNames[record.DeviceId] : "N/A";
                        <tr>
                            <td><strong>@record.Id</strong></td>
                            <td>@deviceName</td>
                            <td>@record.Type</td>
                            <td>@record.Description</td>
                            <td>@record.ScheduledDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-@(record.Status.ToString() == "Completed" ? "success" : record.Status.ToString() == "In Progress" ? "primary" : record.Status.ToString() == "Scheduled" ? "warning" : "secondary")">
                                    @record.Status
                                </span>
                            </td>
                            <td>$@record.TotalCost.ToString("N0")</td>
                            <td>
                                <a asp-page="/Admin/MaintenanceEdit" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Admin/MaintenanceDetails" asp-route-id="@record.Id" class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-tools display-6"></i>
                            <p class="lead mt-2">No maintenance records found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
      function beforePrint() {
        console.log('Preparing Maintenance page for printing...');
      }
    </script>
}
