@page
@model ElectricalSafetyModel
@using MomenMedmSys.Core.Entities
@{
    ViewData["Title"] = "Electrical Safety Tests";
}

<h1>@ViewData["Title"]</h1>

@await Html.PartialAsync("_PrintButton")

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <select name="result" class="form-select">
                    <option value="">All Results</option>
                    @foreach (var result in Enum.GetValues(typeof(SafetyTestResult)))
                    {
                        <option value="@result" selected="@(Model.ResultFilter == result.ToString())">@result</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
            <div class="col-md-6">
                <a asp-page="/Admin/ElectricalSafetyCreate" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Schedule Test</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Electrical Safety Tests (@Model.SafetyTestList.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Test ID</th>
                    <th>Device</th>
                    <th>Test Date</th>
                    <th>Next Due</th>
                    <th>Result</th>
                    <th>Inspector</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SafetyTestList.Any())
                {
                    foreach (var test in Model.SafetyTestList)
                    {
                        var deviceName = Model.DeviceNames.ContainsKey(test.DeviceId) ? Model.DeviceNames[test.DeviceId] : "N/A";
                        <tr>
                            <td><strong>@test.Id</strong></td>
                            <td>@deviceName</td>
                            <td>@test.TestDate.ToString("yyyy-MM-dd")</td>
                            <td>@test.NextDueDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-@(test.OverallResult.ToString() == "Pass" || test.OverallResult.ToString() == "PassWithRemarks" ? "success" : "danger")">
                                    @test.OverallResult
                                </span>
                            </td>
                            <td>@test.PerformedBy</td>
                            <td>
                                <a asp-page="/Admin/ElectricalSafetyEdit" asp-route-id="@test.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Admin/ElectricalSafetyDetails" asp-route-id="@test.Id" class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-shield-check display-6"></i>
                            <p class="lead mt-2">No electrical safety tests found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
      function beforePrint() {
        console.log('Preparing Electrical Safety page for printing...');
      }
    </script>
}
