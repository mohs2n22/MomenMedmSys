<UserControl x:Class="MomenMedmSys.WPF.Views.AdvancedDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:lvcCore="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:lvcPaint="clr-namespace:LiveChartsCore.SkiaSharpView.Painting;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityCollapsed x:Key="NullToVisibilityCollapsed"/>

        <!-- KPI Card Styles -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="0" Direction="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="KpiSubValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Chart Card Style -->
        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="0" Direction="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Table Card Style -->
        <Style x:Key="TableCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="0" Direction="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">
            <!-- Loading Overlay -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#80FFFFFF" Panel.ZIndex="10"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="11">
                    <TextBlock Text="Loading analytics..." FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,16,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="0" Direction="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Analytics Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Date Range Selector -->
                        <TextBlock Text="Period:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#475569"/>
                        <ComboBox x:Name="DateRangeCombo"
                                  ItemsSource="{Binding DateRangeOptions}"
                                  SelectedItem="{Binding SelectedDateRange, Mode=TwoWay}"
                                  Width="140" Margin="0,0,12,0"
                                  Padding="10,6" FontSize="13"
                                  BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton" Focusable="False"
                                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ContentSite" Margin="10,6"
                                                                          Content="{TemplateBinding SelectionBoxItem}"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- Refresh Button -->
                        <Button Content="&#x21BB; Refresh" Command="{Binding LoadAllDataCommand}" Style="{StaticResource ToolbarButtonStyle}"/>

                        <!-- Export Button -->
                        <Button Content="&#x1F4C5; Export Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <Button.Background>
                                <SolidColorBrush Color="#10B981"/>
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI Cards Section - Row 1 -->
            <WrapPanel Margin="0,0,0,4">
                <!-- Equipment Availability -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,12">
                            <TextBlock Text="%" FontSize="18" FontWeight="Bold" Foreground="#10B981"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Equipment Availability" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding EquipmentAvailability, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#10B981"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Operational uptime" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- MTBF -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E3F2FD" Margin="0,0,0,12">
                            <TextBlock Text="MT" FontSize="16" FontWeight="Bold" Foreground="#3B82F6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MTBF" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding Mtbf, StringFormat={}{0:N1} days}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#3B82F6"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Mean Time Between Failures" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- MTTR -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FFF3E0" Margin="0,0,0,12">
                            <TextBlock Text="TR" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MTTR" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding Mttr, StringFormat={}{0:N1} hrs}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#F59E0B"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Mean Time To Repair" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Maintenance Completion Rate -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,12">
                            <TextBlock Text="MR" FontSize="16" FontWeight="Bold" Foreground="#10B981"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Completion Rate" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding MaintenanceCompletionRate, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#10B981"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="On-time completion" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- KPI Cards Section - Row 2 -->
            <WrapPanel Margin="0,0,0,4">
                <!-- Calibration Compliance -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E3F2FD" Margin="0,0,0,12">
                            <TextBlock Text="CC" FontSize="16" FontWeight="Bold" Foreground="#3B82F6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Calibration Compliance" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding CalibrationCompliance, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#3B82F6"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="On-schedule calibration" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Avg Cost per Device -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FEF3C7" Margin="0,0,0,12">
                            <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Avg Cost per Device" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding CostPerDevice, StringFormat=${}{0:N2}}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#F59E0B"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Average maintenance cost" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Open Work Orders -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FFF3E0" Margin="0,0,0,12">
                            <TextBlock Text="WO" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Open Work Orders" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding OpenWorkOrders}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#F59E0B"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Active work orders" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Overdue Items -->
                <Border Style="{StaticResource KpiCardStyle}" MinWidth="220">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FEE2E2" Margin="0,0,0,12">
                            <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#EF4444"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Overdue Items" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding OverdueItems}" Style="{StaticResource KpiValueStyle}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#EF4444"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Requires attention" Style="{StaticResource KpiSubValueStyle}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts Section - 2x2 Grid -->
            <!-- Row 1: Work Order Status + Maintenance Trend -->
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Work Order Status - Pie Chart -->
                <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Work Order Status Distribution" Style="{StaticResource SectionTitleStyle}"/>
                        <lvc:PieChart Series="{Binding WorkOrderStatusSeries}"
                                      Height="280"
                                      InitialRotation="-90"
                                      LegendPosition="Bottom">
                            <lvc:PieChart.LegendTextPaint>
                                <lvcPaint:SolidColorPaint Color="#475569"/>
                            </lvc:PieChart.LegendTextPaint>
                        </lvc:PieChart>
                        <TextBlock Text="No data available" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkOrderStatusSeries.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Maintenance Trend - Line Chart -->
                <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Maintenance Trend - Last 12 Months" Style="{StaticResource SectionTitleStyle}"/>
                        <lvc:CartesianChart Series="{Binding MaintenanceTrendSeries}"
                                            Height="280"
                                            LegendPosition="Bottom">
                            <lvc:CartesianChart.XAxes>
                                <lvcCore:Axis Labels="{Binding MaintenanceTrendLabels}" LabelsRotation="-45" TextSize="10">
                                    <lvcCore:Axis.TextPaint>
                                        <lvcPaint:SolidColorPaint Color="#94A3B8"/>
                                    </lvcCore:Axis.TextPaint>
                                </lvcCore:Axis>
                            </lvc:CartesianChart.XAxes>
                            <lvc:CartesianChart.YAxes>
                                <lvcCore:Axis TextSize="10">
                                    <lvcCore:Axis.TextPaint>
                                        <lvcPaint:SolidColorPaint Color="#94A3B8"/>
                                    </lvcCore:Axis.TextPaint>
                                </lvcCore:Axis>
                            </lvc:CartesianChart.YAxes>
                        </lvc:CartesianChart>
                        <TextBlock Text="No data available" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaintenanceTrendSeries.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Device Status + Department Costs -->
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device Status Distribution - Donut Chart -->
                <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Device Status Distribution" Style="{StaticResource SectionTitleStyle}"/>
                        <lvc:PieChart Series="{Binding DeviceStatusSeries}"
                                      Height="280"
                                      InitialRotation="-90"
                                      LegendPosition="Bottom">
                            <lvc:PieChart.LegendTextPaint>
                                <lvcPaint:SolidColorPaint Color="#475569"/>
                            </lvc:PieChart.LegendTextPaint>
                        </lvc:PieChart>
                        <TextBlock Text="No data available" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceStatusSeries.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Department Costs - Bar Chart -->
                <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Department Cost Comparison" Style="{StaticResource SectionTitleStyle}"/>
                        <lvc:CartesianChart Series="{Binding DepartmentCostSeries}"
                                            Height="280"
                                            LegendPosition="Bottom">
                            <lvc:CartesianChart.XAxes>
                                <lvcCore:Axis Labels="{Binding DepartmentCostLabels}" LabelsRotation="-30" TextSize="10">
                                    <lvcCore:Axis.TextPaint>
                                        <lvcPaint:SolidColorPaint Color="#94A3B8"/>
                                    </lvcCore:Axis.TextPaint>
                                </lvcCore:Axis>
                            </lvc:CartesianChart.XAxes>
                            <lvc:CartesianChart.YAxes>
                                <lvcCore:Axis TextSize="10">
                                    <lvcCore:Axis.TextPaint>
                                        <lvcPaint:SolidColorPaint Color="#94A3B8"/>
                                    </lvcCore:Axis.TextPaint>
                                </lvcCore:Axis>
                            </lvc:CartesianChart.YAxes>
                        </lvc:CartesianChart>
                        <TextBlock Text="No data available" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DepartmentCostSeries.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Section - Tables -->
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top 10 Failing Equipment -->
                <Border Grid.Column="0" Style="{StaticResource TableCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top 10 Failing Equipment" Style="{StaticResource SectionTitleStyle}"/>
                        <DataGrid ItemsSource="{Binding TopFailingEquipment}"
                                  Style="{StaticResource DataGridStyle}"
                                  Height="260"
                                  MaxHeight="260"
                                  HeadersVisibility="Column"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding DeviceCode}" Width="1.2*"/>
                                <DataGridTextColumn Header="Dept" Binding="{Binding Department}" Width="1*"/>
                                <DataGridTextColumn Header="Maint." Binding="{Binding MaintenanceCount}" Width="0.7*"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding TotalCost, StringFormat={}{0:C2}}" Width="1*"/>
                                <DataGridTextColumn Header="Downtime" Binding="{Binding DowntimeHours, StringFormat={}{0:N1}h}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Warranty Expiry Timeline -->
                <Border Grid.Column="1" Style="{StaticResource TableCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Warranty Expiry Timeline" Style="{StaticResource SectionTitleStyle}"/>
                        <DataGrid ItemsSource="{Binding WarrantyExpiryTimeline}"
                                  Style="{StaticResource DataGridStyle}"
                                  Height="260"
                                  MaxHeight="260"
                                  HeadersVisibility="Column"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quarter" Binding="{Binding Quarter}" Width="*"/>
                                <DataGridTextColumn Header="Devices" Binding="{Binding DeviceCount}" Width="0.7*"/>
                                <DataGridTextColumn Header="Devices Expiring" Binding="{Binding DeviceList}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
