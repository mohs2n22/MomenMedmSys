<Window x:Class="MomenMedmSys.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters"
        Title="MomenMedmSys" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundLight}">

    <Window.Resources>
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
        <converters:NullToVisibilityCollapsed x:Key="NullToVisibilityCollapsed"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundDark}" BorderBrush="#334155" BorderThickness="0,0,0,1" Height="64">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- System Logo -->
                    <Border Background="{StaticResource PrimaryColor}" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                        <Grid>
                            <Path Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" 
                                  Stroke="White" StrokeThickness="1.5" Fill="None" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="24" Height="24"/>
                            <Ellipse Fill="White" Width="6" Height="6" Margin="0,-6,0,0" Opacity="0.8"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MomenMedmSys" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Medical Equipment Management System" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SidebarHoverColor}" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Administrator" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Super Admin" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Background="{StaticResource SidebarColor}" BorderBrush="#334155" BorderThickness="0,0,1,0" Width="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="SidebarList" ItemsSource="{Binding NavigationItems}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="Transparent"
                                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseLeftButtonUp" Handler="NavItemClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#475569" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Icon}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextOnDark}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Background="#0F172A" Padding="16" CornerRadius="0">
                    <StackPanel>
                        <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="© 2026 MomenMedmSys" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Background="{StaticResource BackgroundLight}">
            <DockPanel>
                <!-- Status Bar -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BackgroundDark}" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="← Back" Command="{Binding GoBackCommand}" Padding="8,3" FontSize="12"
                                    Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGoBack}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="© 2026 MomenMedmSys v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- Content -->
                <Border Padding="32">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
