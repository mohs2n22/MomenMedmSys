<Window x:Class="MomenMedmSys.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Momen Systems Co." Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="Assets/AppIcon.ico">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Custom Window Border / Drop Shadow -->
    <Border Background="{DynamicResource BackgroundLight}">
        <DockPanel>
            
            <!-- ========== TOP HEADER (Titlebar) ========== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Height="64">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border Width="40" Height="40" Margin="0,0,12,0" CornerRadius="{StaticResource Radius.Md}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#C084FC" Offset="0"/>
                                    <GradientStop Color="#9333EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="Assets/AppIcon.ico" Width="30" Height="30"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Momen Systems Co." FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Medical Equipment Management System" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Profile & Windows Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        
                        <!-- Search Box (mock) -->
                        <Border Background="{StaticResource Bg.SurfaceAlt}" Padding="12,9" Width="200" Margin="0,0,16,0" CornerRadius="{StaticResource Radius.Md}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Text.Secondary}"/>
                                <TextBlock Grid.Column="1" Text="Quick search..." FontSize="13" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Profile -->
                        <Border Background="{StaticResource Bg.SurfaceAlt}" Padding="8,4" CornerRadius="{StaticResource Radius.Xl}" Margin="0,0,24,0" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource Bg.Sidebar}" Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                    <TextBlock Text="U" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Administrator" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Super Admin" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="BtnMinimize_Click" Width="40" Height="32" Background="Transparent" BorderThickness="0" Content="—" Foreground="{StaticResource Text.Secondary}" FontSize="14" FontWeight="Bold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="BtnMaximize_Click" Width="40" Height="32" Background="Transparent" BorderThickness="0" Content="☐" Foreground="{StaticResource Text.Secondary}" FontSize="16" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="BtnClose_Click" Width="40" Height="32" Background="Transparent" BorderThickness="0" Content="✕" Foreground="{StaticResource Text.Secondary}" FontSize="14" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Danger.500}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== SIDEBAR NAVIGATION ========== -->
            <Border DockPanel.Dock="Left" Width="260">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="24,20,24,10" Text="MAIN NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Color.Slate.600}" />

                    <ListBox Grid.Row="1" x:Name="SidebarList" ItemsSource="{Binding NavigationItems}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="12,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Color.Slate.400}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius.Md}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Primary.600}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Slate.700}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="MouseLeftButtonUp" Handler="NavItemClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource Color.Slate.950}" Padding="20" Opacity="0.9">
                        <StackPanel>
                            <TextBlock Text="System Status: Online" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.Success.500}" Margin="0,0,0,4"/>
                            <TextBlock Text="Version 2.0" FontSize="11" Foreground="{StaticResource Color.Slate.600}"/>
                            <TextBlock Text="© 2026 Momen Systems Co." FontSize="11" Foreground="{StaticResource Color.Slate.600}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========== MAIN CONTENT AREA ========== -->
            <Border Background="{StaticResource Bg.App}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Surface}" Padding="16,6" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border.Default}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="← Back" Command="{Binding GoBackCommand}" Padding="12,6" FontSize="13" FontWeight="SemiBold" Background="{StaticResource Bg.SurfaceAlt}" Foreground="{StaticResource Text.Secondary}" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanGoBack}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="16,0"/>
                            <TextBlock Grid.Column="2" Text="Synchronized at 10:42 AM" Foreground="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <Border>
                        <ContentControl Content="{Binding CurrentView}"/>
                    </Border>
                </DockPanel>
            </Border>
            
        </DockPanel>
    </Border>

</Window>
