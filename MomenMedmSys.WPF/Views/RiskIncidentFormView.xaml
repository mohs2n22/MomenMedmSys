<UserControl x:Class="MomenMedmSys.WPF.Views.RiskIncidentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32" MaxWidth="900">
            <StackPanel>
                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B">
                                <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Risk Incident"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="12,6">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding Mode, Mode=OneWay}"/>
                            </TextBlock>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Add">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="TextElement.Foreground" Value="#1E40AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Edit">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Section: Incident Details -->
                <TextBlock Text="Incident Details" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Title *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Incident Code" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding IncidentCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Incident Date" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding IncidentDate}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Reported By" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ReportedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Location" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding IncidentLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Incident Type" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding IncidentType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Severity" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Probability" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProbabilityOptions}" SelectedItem="{Binding Probability, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Description" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Root Cause" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding RootCause, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Actions & Resolution -->
                <TextBlock Text="Corrective &amp; Preventive Actions" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Corrective Actions" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CorrectiveActions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Preventive Actions" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PreventiveActions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Status" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Resolution" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Injury & Recall -->
                <TextBlock Text="Injury &amp; Recall Information" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <CheckBox Content="Patient Injury" IsChecked="{Binding PatientInjury}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                        <CheckBox Content="Staff Injury" IsChecked="{Binding StaffInjury}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                        <CheckBox Content="Regulatory Reported" IsChecked="{Binding RegulatoryReported}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Affected Patients" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AffectedPatients, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                        <TextBlock Text="Affected Staff" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding AffectedStaff, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <CheckBox Content="Product Recall" IsChecked="{Binding IsRecall}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Width="100" Padding="12,8"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="140" Padding="12,8">
                        <TextBlock>
                            <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Incident"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

