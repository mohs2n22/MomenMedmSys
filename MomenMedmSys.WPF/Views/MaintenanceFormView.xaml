<UserControl x:Class="MomenMedmSys.WPF.Views.MaintenanceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32" MaxWidth="960">

            <!-- Page Header -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,20" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270"/></Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Maintenance Record"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Section: Record Details -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Primary}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Record Details" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Maintenance type, status and description" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Title *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RecordTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="Preventive"/><ComboBoxItem Content="Corrective"/>
                                <ComboBoxItem Content="Emergency"/><ComboBoxItem Content="Inspection"/><ComboBoxItem Content="Calibration"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" TextWrapping="Wrap" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="InProgress"/>
                                <ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/><ComboBoxItem Content="Overdue"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Recurrence" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Recurrence, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="None"/><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="Monthly"/><ComboBoxItem Content="Quarterly"/><ComboBoxItem Content="SemiAnnually"/><ComboBoxItem Content="Annually"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Performed By" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Scheduling & Costs -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Warning}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Schedule &amp; Cost" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Dates and cost breakdown" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Scheduled Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding ScheduledDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Completed Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding CompletedDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Labor Cost ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Parts Cost ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PartsCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Findings -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Success}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Findings &amp; Actions" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Observations and corrective actions taken" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Findings" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Findings, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Actions Taken" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ActionsTaken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,18">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Width="110" Padding="14,10" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Padding="14,10">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Record"/></TextBlock>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
