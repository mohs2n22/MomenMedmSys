<UserControl x:Class="MomenMedmSys.WPF.Views.MaintenanceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32" MaxWidth="900">
            <StackPanel>
                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Maintenance Record"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Record Details -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Title *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding RecordTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Type" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="Preventive"/><ComboBoxItem Content="Corrective"/>
                            <ComboBoxItem Content="Emergency"/><ComboBoxItem Content="Inspection"/><ComboBoxItem Content="Calibration"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Description" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Status" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="InProgress"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/><ComboBoxItem Content="Overdue"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Scheduled Date" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ScheduledDate}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Completed Date" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding CompletedDate}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Performed By" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Recurrence" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Recurrence, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="None"/><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/>
                            <ComboBoxItem Content="Monthly"/><ComboBoxItem Content="Quarterly"/><ComboBoxItem Content="SemiAnnually"/><ComboBoxItem Content="Annually"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="Labor Cost ($)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Parts Cost ($)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PartsCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Grid.Column="0">
                        <TextBlock Text="Findings" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Findings, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Row="10" Grid.Column="2">
                        <TextBlock Text="Actions Taken" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ActionsTaken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Width="100" Padding="12,8"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="160" Padding="12,8">
                        <TextBlock><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Record"/></TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
