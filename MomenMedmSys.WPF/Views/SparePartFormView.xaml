<UserControl x:Class="MomenMedmSys.WPF.Views.SparePartFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32" MaxWidth="900">
            <StackPanel>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Spare Part"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Part Number" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Part Name *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Category" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Manufacturer" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Supplier" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Storage Location" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Current Stock" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Unit Cost ($)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="Minimum Stock" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Maximum Stock" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MaximumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Grid.Column="0">
                        <CheckBox Content="Critical Part" IsChecked="{Binding IsCritical}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                        <CheckBox Content="Obsolete" IsChecked="{Binding IsObsolete}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Row="10" Grid.Column="2">
                        <TextBlock Text="Description" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Width="100" Padding="12,8"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="140" Padding="12,8">
                        <TextBlock><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Part"/></TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
