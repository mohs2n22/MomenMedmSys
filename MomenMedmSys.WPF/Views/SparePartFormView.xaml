<UserControl x:Class="MomenMedmSys.WPF.Views.SparePartFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32" MaxWidth="960">

            <!-- Page Header -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,20" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270"/></Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Spare Part"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Section: Part Identification -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Indigo}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Part Identification" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Name, category, manufacturer and supplier" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Part Number (Auto)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" IsReadOnly="True" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Part Name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Storage Location" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Inventory & Cost -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Warning}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Inventory &amp; Cost" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Stock levels, pricing, and flags" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Current Stock" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Unit Cost ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Minimum Stock" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Maximum Stock" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MaximumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <CheckBox Content="Critical Part" IsChecked="{Binding IsCritical}" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="14" Foreground="#334155"/>
                            <CheckBox Content="Obsolete" IsChecked="{Binding IsObsolete}" VerticalAlignment="Center" FontSize="14" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,18">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Width="110" Padding="14,10" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Padding="14,10">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Part"/></TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
