<UserControl x:Class="MomenMedmSys.WPF.Views.SupplierFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32" MaxWidth="900">
            <StackPanel>
                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B">
                                <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Supplier"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="12,6">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding Mode, Mode=OneWay}"/>
                            </TextBlock>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Add">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="TextElement.Foreground" Value="#1E40AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Edit">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Section: Company Details -->
                <TextBlock Text="Company Details" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Company Name *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Supplier Code" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Contact Person" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Rating" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Phone" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Website" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Country" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="City" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <CheckBox Content="Approved" IsChecked="{Binding IsApproved}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                        <TextBlock Text="Lead Time (Days)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Grid.Column="0">
                        <TextBlock Text="Payment Terms" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PaymentTerms, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <!-- Section: Address -->
                <TextBlock Text="Address" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                <!-- Notes -->
                <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Width="100" Padding="12,8"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="140" Padding="12,8">
                        <TextBlock>
                            <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Supplier"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

