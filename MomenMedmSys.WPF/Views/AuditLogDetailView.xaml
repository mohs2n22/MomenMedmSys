<UserControl x:Class="MomenMedmSys.WPF.Views.AuditLogDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Audit Log Detail" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Detailed view of the selected audit entry" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Back button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="&#x2190; Back to Audit Trail" Command="{Binding GoBackCommand}"
                    Style="{StaticResource SecondaryBtn}" Width="160"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">
                <!-- Entity Information Card -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Entity Information" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Entity Type:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EntityType}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Entity ID:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EntityId}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Action:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <Border Grid.Row="2" Grid.Column="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Action}" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="Create">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Update">
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}" Value="Create">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="Update">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Affected Records:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AffectedRecords}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Timestamp:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="IP Address:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IpAddress}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- User Information Card -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="User Information" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User Name:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="User ID:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserId}" FontSize="14" Foreground="#1E293B" Margin="0,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Old Values vs New Values -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Old Values -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Old Values (Before Change)" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,12"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBox Text="{Binding OldValuesFormatted}" FontFamily="Consolas, Courier New" FontSize="12"
                                         IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                         Background="Transparent" VerticalScrollBarVisibility="Auto"
                                         Foreground="#374151"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Grid.Column="1" Background="#E2E8F0" Width="1" Margin="0,20"/>

                    <!-- New Values -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="New Values (After Change)" FontSize="16" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,12"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBox Text="{Binding NewValuesFormatted}" FontFamily="Consolas, Courier New" FontSize="12"
                                         IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                         Background="Transparent" VerticalScrollBarVisibility="Auto"
                                         Foreground="#374151"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

