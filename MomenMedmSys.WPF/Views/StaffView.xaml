<UserControl x:Class="MomenMedmSys.WPF.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Staff &amp; Training" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Manage personnel and training records" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,0,0,16" SelectedIndex="{Binding TabIndex}">
            <!-- Staff Tab -->
            <TabItem Header="👥 Staff Members">
                <Grid Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="🔄 Refresh" Command="{Binding LoadStaffCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                        <TextBlock Text="{Binding ActiveStaffCount, StringFormat='Active: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#64748B"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StaffMembers}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource DataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False"
                              SelectionMode="Single" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
                            <DataGridTextColumn Header="Job Title" Binding="{Binding JobTitle}" Width="140"/>
                            <DataGridTextColumn Header="Hire Date" Binding="{Binding HireDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Certifications" Binding="{Binding Certifications}" Width="200"/>
                            <DataGridTextColumn Header="License" Binding="{Binding LicenseNumber}" Width="120"/>
                            <DataGridTextColumn Header="License Expiry" Binding="{Binding LicenseExpiryDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Training Tab -->
            <TabItem Header="📚 Training Records">
                <Grid Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="🔄 Refresh" Command="{Binding LoadTrainingCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                        <TextBlock Text="{Binding ExpiredTrainingCount, StringFormat='Expired: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#EF4444"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TrainingRecords}" SelectedItem="{Binding SelectedTraining}"
                              Style="{StaticResource DataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False"
                              SelectionMode="Single" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding TrainingTitle}" Width="200"/>
                            <DataGridTextColumn Header="Staff" Binding="{Binding StaffMember.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device.DeviceName}" Width="160"/>
                            <DataGridTextColumn Header="Training Date" Binding="{Binding TrainingDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                            <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding TrainingProvider}" Width="110"/>
                            <DataGridTextColumn Header="Passed" Binding="{Binding AssessmentPassed}" Width="70"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding AssessmentScore}" Width="70"/>
                            <DataGridTextColumn Header="Cert #" Binding="{Binding CertificationNumber}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
