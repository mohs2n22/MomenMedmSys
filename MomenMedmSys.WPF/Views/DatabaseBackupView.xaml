<UserControl x:Class="MomenMedmSys.WPF.Views.DatabaseBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Database Backup &amp; Restore" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Manage database backups, restore from previous versions, and configure backup settings" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex}">
            <!-- ==================== TAB 1: BACKUP ==================== -->
            <TabItem Header="Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Current Database Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <!-- Database Info Card -->
                            <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Current Database" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Location:" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDatabasePath}" Foreground="#1E293B" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Database Size:" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDatabaseSize}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Last Modified:" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDatabaseLastModified}" Foreground="#1E293B" FontSize="13"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Available Disk Space:" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AvailableDiskSpace}" Foreground="#166534" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Backup History -->
                            <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Recent Backups" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                    <DataGrid ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup}"
                                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                              CanUserSortColumns="True" CanUserResizeColumns="True"
                                              MaxHeight="300"
                                              BorderBrush="#E2E8F0" BorderThickness="1"
                                              Background="White"
                                              RowBackground="White" AlternatingRowBackground="#F8FAFC">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="200"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding FileSizeBytes, StringFormat={}{0:N0} B}" Width="100"/>
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                            <DataGridTemplateColumn Header="Type" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="4,2" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding IsCompressed, StringFormat={}{0}}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value=".db"/>
                                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                                <Setter Property="Text" Value=".gz"/>
                                                                                <Setter Property="Foreground" Value="#7C3AED"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                            <Setter Property="Background" Value="#EDE9FE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Status" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="4,2" HorizontalAlignment="Center">
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Valid"/>
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                                <Setter Property="Text" Value="Invalid"/>
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Backup Actions -->
                        <StackPanel Grid.Column="1">
                            <!-- Create Backup Card -->
                            <Border Background="#F0FDF4" CornerRadius="8" BorderBrush="#BBF7D0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Create Backup" FontSize="16" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,12"/>

                                    <TextBlock Text="Backup Directory:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                             Padding="8,6" Margin="0,0,0,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                             FontSize="12"/>

                                    <Button Content="Change Directory" Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryBtn}" Width="140" Margin="0,0,0,12"
                                            HorizontalAlignment="Left"/>

                                    <Button Content="Create Backup Now" Command="{Binding CreateBackupCommand}"
                                            Padding="16,10" FontSize="14" FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#166534"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Progress -->
                                    <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}"
                                                 Maximum="100" Height="6" Margin="0,8,0,0" Visibility="Visible">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBackingUp}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>

                            <!-- Quick Actions -->
                            <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                    <Button Content="Validate Selected Backup" Command="{Binding ValidateSelectedBackupCommand}"
                                            Style="{StaticResource SecondaryBtn}" Width="200" Margin="0,0,0,8"
                                            HorizontalAlignment="Left"/>
                                    <Button Content="Cleanup Old Backups" Command="{Binding CleanupOldBackupsCommand}"
                                            Style="{StaticResource SecondaryBtn}" Width="200" Margin="0,0,0,8"
                                            HorizontalAlignment="Left"/>
                                    <Button Content="Test Backup" Command="{Binding TestBackupCommand}"
                                            Style="{StaticResource SecondaryBtn}" Width="200"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 2: RESTORE ==================== -->
            <TabItem Header="Restore">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Warning Banner -->
                        <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="8" BorderBrush="#FCD34D" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#9888;&#xFE0F;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Warning: Restoring a Backup" FontSize="16" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock Text="Restoring a backup will replace the current database. All changes made since the backup was created will be lost. The application will need to restart after restore."
                                               FontSize="13" Foreground="#78350F" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Current Database Info -->
                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#128451;&#xFE0F;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Current Database" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding CurrentDatabasePath}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="Size: "/><Run Text="{Binding CurrentDatabaseSize}"/><Run Text=" | Last modified: "/><Run Text="{Binding CurrentDatabaseLastModified}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Available Backups -->
                        <TextBlock Grid.Row="2" Text="Available Backups" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  BorderBrush="#E2E8F0" BorderThickness="1"
                                  Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  Margin="0,32,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="250"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeBytes, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding IsCompressed, StringFormat={}{0}}" Width="70"/>
                                <DataGridTemplateColumn Header="Valid" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Yes"/>
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Text" Value="No"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Validation" Binding="{Binding ValidationMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Restore Actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Restore Selected Backup" Command="{Binding RestoreBackupCommand}"
                                    Padding="16,10" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#94A3B8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Validate Selected" Command="{Binding ValidateSelectedBackupCommand}"
                                    Style="{StaticResource SecondaryBtn}" Width="140" Margin="0,0,12,0"/>
                            <Button Content="Delete Selected" Command="{Binding DeleteBackupCommand}"
                                    Style="{StaticResource SecondaryBtn}" Width="130"/>
                        </StackPanel>

                        <!-- Progress -->
                        <ProgressBar Grid.Row="3" IsIndeterminate="{Binding IsProgressIndeterminate}" Height="6" Margin="0,16,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 3: SETTINGS ==================== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel MaxWidth="600">
                        <!-- Backup Directory -->
                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Backup Location" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <TextBlock Text="Default Backup Directory:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8"
                                         BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13"/>

                                <Button Content="Browse..." Command="{Binding BrowseBackupDirectoryCommand}"
                                        Style="{StaticResource SecondaryBtn}" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Backup Settings -->
                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Auto-Backup" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <CheckBox Content="Enable automatic backups" IsChecked="{Binding AutoBackupEnabled}"
                                          FontSize="14" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <TextBlock Text="Backup Frequency:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding BackupFrequency, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12"
                                          BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" IsEnabled="{Binding AutoBackupEnabled}">
                                    <ComboBoxItem Content="Daily"/>
                                    <ComboBoxItem Content="Weekly"/>
                                    <ComboBoxItem Content="Monthly"/>
                                </ComboBox>

                                <TextBlock Text="Retention Policy" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="Number of recent backups to keep:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding RetentionCount, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="8,6"
                                             BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" Margin="0,0,8,0"
                                             TextAlignment="Center"/>
                                    <TextBlock Text="backups" VerticalAlignment="Center" Foreground="#64748B" FontSize="13"/>
                                </StackPanel>

                                <Button Content="Apply Cleanup Now" Command="{Binding CleanupOldBackupsCommand}"
                                        Style="{StaticResource SecondaryBtn}" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Compression -->
                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Compression" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <CheckBox Content="Compress backups with GZip (saves ~70-80% disk space)"
                                          IsChecked="{Binding CompressBackups}" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="Compressed backups take slightly longer to create but use significantly less disk space."
                                           FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Test -->
                        <Border Background="#F0FDF4" CornerRadius="8" BorderBrush="#BBF7D0" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Test Configuration" FontSize="16" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,12"/>
                                <TextBlock Text="Run a test backup to verify everything is configured correctly. The test backup is created in a temporary folder and then deleted."
                                           FontSize="13" Foreground="#64748B" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <Button Content="Test Backup" Command="{Binding TestBackupCommand}"
                                        Style="{StaticResource SecondaryBtn}" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>

