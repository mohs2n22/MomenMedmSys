<UserControl x:Class="MomenMedmSys.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">
            <!-- Header -->
            <TextBlock Text="📊 Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
            <Button Content="🔄 Refresh" Command="{Binding LoadStatsCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,24" Width="120"/>

            <!-- Device Inventory Stats -->
            <TextBlock Text="Device Inventory" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,24">
                <Border Style="{StaticResource StatCardBlue}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Total Devices" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding TotalDevices}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardGreen}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Active" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding ActiveDevices}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardAmber}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Under Maintenance" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding UnderMaintenanceDevices}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardRed}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Out of Service" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding OutOfServiceDevices}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardPurple}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Total Asset Value" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding TotalAssetValue, StringFormat=${0:N0}}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Alert Stats -->
            <TextBlock Text="Alerts &amp; Notifications" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,24">
                <Border Style="{StaticResource StatCardRed}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Overdue Maintenance" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding OverdueMaintenanceCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardAmber}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Overdue Calibration" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding OverdueCalibrationCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardRed}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Open Incidents" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding OpenIncidentsCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardRed}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Critical Incidents" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding CriticalIncidentsCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardPurple}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Open Work Orders" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding OpenWorkOrdersCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardTeal}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Low Stock Parts" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding LowStockPartsCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Alerts Section -->
            <TextBlock Text="⚠ Active Alerts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource WarningBgColor}" CornerRadius="8" Padding="16" BorderBrush="#FFE0B2" BorderThickness="1" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextOnWarning}" Margin="0,4" FontSize="14"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <TextBlock Text="No active alerts" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,0,24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Warranty Expiry Alerts -->
            <TextBlock Text="📋 Warranty Expiry Alerts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource InfoBgColor}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource PrimaryLighterColor}" BorderThickness="1" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding WarrantyAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextOnPrimary}" Margin="0,4" FontSize="14"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WarrantyAlerts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
