<UserControl x:Class="MomenMedmSys.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.6}">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Inventory Dashboard" Style="{StaticResource SectionTitle}" FontSize="{StaticResource FontSize.3xl}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetricSubText}" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Refresh" Command="{Binding LoadStatsCommand}" Style="{StaticResource PrimaryBtn}" Width="120" VerticalAlignment="Center"/>
            </Grid>

            <!-- Device Inventory Stats -->
            <Border Style="{StaticResource GlassCard}" Padding="{StaticResource Space.4}">
                <StackPanel>
                    <TextBlock Text="Device Inventory" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource StatCard.Primary}">
                            <StackPanel>
                                <TextBlock Text="Total Devices" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding TotalDevices}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Success}">
                            <StackPanel>
                                <TextBlock Text="Active" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ActiveDevices}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Warning}">
                            <StackPanel>
                                <TextBlock Text="Maintenance" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding UnderMaintenanceDevices}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Danger}">
                            <StackPanel>
                                <TextBlock Text="Out of Service" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding OutOfServiceDevices}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Purple}">
                            <StackPanel>
                                <TextBlock Text="Asset Value" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding TotalAssetValue, StringFormat=${0:N0}}" Foreground="White" FontSize="{StaticResource FontSize.2xl}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Alert Stats -->
            <Border Style="{StaticResource GlassCard}" Padding="{StaticResource Space.4}">
                <StackPanel>
                    <TextBlock Text="Alerts &amp; Notifications" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource StatCard.Danger}">
                            <StackPanel>
                                <TextBlock Text="Overdue Maint" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding OverdueMaintenanceCount}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Warning}">
                            <StackPanel>
                                <TextBlock Text="Overdue Calib" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding OverdueCalibrationCount}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Rose}">
                            <StackPanel>
                                <TextBlock Text="Open Incidents" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding OpenIncidentsCount}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Indigo}">
                            <StackPanel>
                                <TextBlock Text="Open WOs" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding OpenWorkOrdersCount}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard.Teal}">
                            <StackPanel>
                                <TextBlock Text="Low Stock" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding LowStockPartsCount}" Foreground="White" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Active Alerts Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="⚠ Critical Maintenance Alerts" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Color.Danger.600}"/>
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Color.Danger.50}" CornerRadius="{StaticResource Radius.Sm}" Padding="12,8" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Text.Danger}" FontSize="{StaticResource FontSize.Base}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No active maintenance alerts" HorizontalAlignment="Center" Margin="0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetricSubText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📋 Warranty Notifications" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Color.Primary.600}"/>
                        <ItemsControl ItemsSource="{Binding WarrantyAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Color.Primary.50}" CornerRadius="{StaticResource Radius.Sm}" Padding="12,8" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Color.Primary.700}" FontSize="{StaticResource FontSize.Base}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No warranty notifications" HorizontalAlignment="Center" Margin="0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetricSubText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WarrantyAlerts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
