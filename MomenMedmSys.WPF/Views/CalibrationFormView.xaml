<UserControl x:Class="MomenMedmSys.WPF.Views.CalibrationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32" MaxWidth="960">

            <!-- Page Header -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,20" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270"/></Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Calibration Record"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Section: Calibration Details -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Teal}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Calibration Details" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Type, standard, and result information" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Calibration Type" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CalibrationType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Standard Used" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StandardUsed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Performed By" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Result" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="Pass"/><ComboBoxItem Content="Fail"/><ComboBoxItem Content="PassWithAdjustment"/>
                                <ComboBoxItem Content="OutOfTolerance"/><ComboBoxItem Content="NotCalibrated"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Certificate Number" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CertificateNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Schedule & Data -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Primary}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Schedule &amp; Measurement Data" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Dates and as-found/as-left readings" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Calibration Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding CalibrationDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Next Due Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding NextDueDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="As-Found Data" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AsFoundData, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="As-Left Data" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AsLeftData, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,18">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Width="110" Padding="14,10" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Padding="14,10">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Record"/></TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
