<UserControl x:Class="MomenMedmSys.WPF.Views.DeviceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32" MaxWidth="960">

            <!-- ===== PAGE HEADER ===== -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="28,20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                            <Run Text="{Binding Mode, Mode=OneWay}"/>
                            <Run Text=" Medical Device"/>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Mode Badge -->
                    <Border Grid.Column="1" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold">
                            <Run Text="{Binding Mode, Mode=OneWay}"/>
                        </TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Add">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="TextElement.Foreground" Value="#1E40AF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Edit">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== SECTION: IDENTIFICATION ===== -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="28,24" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Section Label -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Primary}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Device Identification" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Basic identification and classification details" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Device Name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Device Code (Auto)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DeviceCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" IsReadOnly="True" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Manufacturer *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="Imaging"/>
                                <ComboBoxItem Content="Monitoring"/>
                                <ComboBoxItem Content="Therapeutic"/>
                                <ComboBoxItem Content="Laboratory"/>
                                <ComboBoxItem Content="Diagnostic"/>
                                <ComboBoxItem Content="Surgical"/>
                                <ComboBoxItem Content="Respiratory"/>
                                <ComboBoxItem Content="Cardiac"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== SECTION: LOCATION & RISK ===== -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="28,24" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Warning}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Location &amp; Risk" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Department assignment and risk classification" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="General"/>
                                <ComboBoxItem Content="Radiology"/>
                                <ComboBoxItem Content="ICU"/>
                                <ComboBoxItem Content="Oncology"/>
                                <ComboBoxItem Content="Laboratory"/>
                                <ComboBoxItem Content="Emergency"/>
                                <ComboBoxItem Content="Operating Room"/>
                                <ComboBoxItem Content="Obstetrics"/>
                                <ComboBoxItem Content="Cardiology"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Risk Classification" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding RiskClassification, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Critical"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Purchase Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding PurchaseDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Purchase Price ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== SECTION: MAINTENANCE FLAGS ===== -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="28,24" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Success}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Maintenance &amp; Specs" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Maintenance requirements and technical specifications" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Requires Calibration" IsChecked="{Binding RequiresCalibration}" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="14" Foreground="#334155"/>
                            <CheckBox Content="Requires Preventive Maintenance" IsChecked="{Binding RequiresPreventiveMaintenance}" VerticalAlignment="Center" FontSize="14" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Technical Specifications" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TechnicalSpecs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== ACTION BUTTONS ===== -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,18">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Width="110" Padding="14,10" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Padding="14,10">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Mode, Mode=OneWay}"/>
                            <Run Text=" Device"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
