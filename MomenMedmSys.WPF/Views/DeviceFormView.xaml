<UserControl x:Class="MomenMedmSys.WPF.Views.DeviceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32" MaxWidth="900">
            <StackPanel>
                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B">
                                <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Device"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="12,6">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding Mode, Mode=OneWay}"/>
                            </TextBlock>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Add">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="TextElement.Foreground" Value="#1E40AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Edit">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Section: Basic Information -->
                <TextBlock Text="Basic Information" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Device Name *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Device Code" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DeviceCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Manufacturer *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Model" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Serial Number" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Category" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="Imaging"/><ComboBoxItem Content="Monitoring"/><ComboBoxItem Content="Therapeutic"/>
                            <ComboBoxItem Content="Laboratory"/><ComboBoxItem Content="Diagnostic"/><ComboBoxItem Content="Surgical"/>
                            <ComboBoxItem Content="Respiratory"/><ComboBoxItem Content="Cardiac"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Department" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="General"/><ComboBoxItem Content="Radiology"/><ComboBoxItem Content="ICU"/>
                            <ComboBoxItem Content="Oncology"/><ComboBoxItem Content="Laboratory"/><ComboBoxItem Content="Emergency"/>
                            <ComboBoxItem Content="Operating Room"/><ComboBoxItem Content="Obstetrics"/><ComboBoxItem Content="Cardiology"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Purchase Date" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding PurchaseDate}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="Purchase Price ($)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Risk Classification" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding RiskClassification, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Critical"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Grid.Column="0">
                        <CheckBox Content="Requires Calibration" IsChecked="{Binding RequiresCalibration}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                        <CheckBox Content="Requires Preventive Maintenance" IsChecked="{Binding RequiresPreventiveMaintenance}" VerticalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Row="10" Grid.Column="2">
                        <TextBlock Text="Technical Specifications" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TechnicalSpecs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Width="100" Padding="12,8"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="140" Padding="12,8">
                        <TextBlock>
                            <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Device"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
