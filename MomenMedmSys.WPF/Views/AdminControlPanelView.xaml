<UserControl x:Class="MomenMedmSys.WPF.Views.AdminControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibility"/>

        <!-- Modern Segmented Tab Bar -->
        <Style x:Key="SegmentedTab" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#C084FC" Offset="0"/>
                                            <GradientStop Color="#9333EA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Content Visibility -->
        <Style x:Key="TabContentStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg.SurfaceAlt}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER BAR ========== -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#9333EA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Admin Control Panel" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="{Binding HospitalName, TargetNullValue='Manage staff, licenses &amp; system settings', FallbackValue='Manage staff, licenses &amp; system settings'}" FontSize="12" Foreground="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hospital / Admin badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                    <Border Background="{StaticResource Color.Blue.50}" Padding="12,8" CornerRadius="8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏥" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding HospitalName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.Blue.800}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HospitalName}" Value="">
                                                <Setter Property="Text" Value="No Hospital Configured"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Color.Success.50}" Padding="12,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AdministratorName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.Success.700}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdministratorName}" Value="">
                                                <Setter Property="Text" Value="No Administrator"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Bg.SurfaceAlt}" Padding="12,9" Width="240" Margin="0,0,12,0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="🔄 Refresh" Command="{Binding LoadAllCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== STATS CARDS ROW ===== -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Style="{StaticResource StatCard.Primary}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="👥 Total Staff" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalStaff}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Success}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="✅ Active" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding ActiveAccounts}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Danger}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🔒 Locked" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding LockedAccounts}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Purple}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🔑 Admins" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding AdminCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Teal}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🔧 Techs" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding TechnicianCount, TargetNullValue=0}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Indigo}" Width="180" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🩺 Docs" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding PhysicianCount, TargetNullValue=0}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Slate}" Width="180">
                    <StackPanel>
                        <TextBlock Text="🛡️ Guards" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding GuardCount, TargetNullValue=0}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== SEGMENTED TAB NAVIGATION ===== -->
            <Border Grid.Row="1" Background="{StaticResource Bg.Surface}" Padding="6" Margin="0,0,0,16" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="12">
                <WrapPanel>
                    <RadioButton x:Name="tabAllStaff" Content="👥 All Staff" Style="{StaticResource SegmentedTab}" IsChecked="True" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabAdmins" Content="🔑 Admins" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabTechs" Content="🔧 Technicians" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabWriters" Content="📝 Writers" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabDoctors" Content="🩺 Physicians" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabNurses" Content="💊 Nurses" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabLicenses" Content="🔐 Licenses" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabSystem" Content="⚙️ System" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                    <RadioButton x:Name="tabAbout" Content="ℹ️ About" Style="{StaticResource SegmentedTab}" GroupName="AdminTabs" Click="Tab_Click"/>
                </WrapPanel>
            </Border>

            <!-- ===== TAB CONTENT AREA ===== -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>

                <!-- ALL STAFF TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                    <StackPanel>
                        <Button Content="➕ Add New Staff" Command="{Binding StartAddNewCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,10" Margin="20,20,0,10" HorizontalAlignment="Right"/>
                        <DataGrid ItemsSource="{Binding FilteredStaff}" SelectedItem="{Binding SelectedStaff}"
                                  Style="{StaticResource ModernDataGrid}" SelectionMode="Single" CanUserSortColumns="True"
                                  Margin="20,10,20,20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EMP ID" Binding="{Binding EmployeeId}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="130"/>
                                <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="110"/>
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/>
                                <DataGridTemplateColumn Header="STATUS" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" HorizontalAlignment="Center" CornerRadius="4">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Text" Value="🔒 Locked"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                                                    <Setter Property="Text" Value="✅ Active"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="TextElement.Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Setter Property="TextElement.Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryBtn}" Padding="6,4" Margin="0,0,4,0" FontSize="12"/>
                                                <Button Content="🗑️" Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerBtn}" Padding="6,4" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ADMINS TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                    <DataGrid ItemsSource="{Binding Administrators}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TECHNICIANS TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                    <DataGrid ItemsSource="{Binding HardwareTechnicians}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="SPECIALIZATION" Binding="{Binding Specialization}" Width="160"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- WRITERS TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                    <DataGrid ItemsSource="{Binding ReportWriters}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- PHYSICIANS TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                    <DataGrid ItemsSource="{Binding Physicians}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="SPECIALIZATION" Binding="{Binding Specialization}" Width="180"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- NURSES TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                    <DataGrid ItemsSource="{Binding Nurses}" SelectedItem="{Binding SelectedStaff}"
                              Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- LICENSES TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=6}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Hospital Information -->
                            <Border Background="#EFF6FF" Padding="20" Margin="0,0,0,16" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🏥 Hospital Information" Style="{StaticResource SectionTitle}" Foreground="#1E40AF"/>
                                    <TextBlock Text="Hospital Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Administrator Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AdministratorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="💾 Save Hospital Info" Command="{Binding SaveHospitalInfoCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding HospitalInfoStatus}" FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- License Generation -->
                            <Border Background="#F5F3FF" Padding="20" Margin="0,0,0,16" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🚀 License Generation" Style="{StaticResource SectionTitle}" Foreground="#5B21B6"/>
                                    <TextBlock Text="License Number" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding InputLicenseNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,12" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="Duration" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox SelectedIndex="{Binding SelectedLicenseTypeIndex}" Style="{StaticResource ModernCombo}" Margin="0,0,0,12">
                                        <ComboBoxItem Content="3 Months (90 days)"/>
                                        <ComboBoxItem Content="1 Year (365 days)"/>
                                        <ComboBoxItem Content="Lifetime (Unlimited)"/>
                                    </ComboBox>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="📄 License File" Command="{Binding GenerateLicenseFileCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                        <Button Content="🚀 Update System" Command="{Binding UpdateSystemCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                        <Button Content="📦 Distribution" Command="{Binding GenerateDistributionPackageCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,10"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="#5B21B6" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DistributionStatus}" FontSize="11" Foreground="#7C3AED" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Manual Key Generation -->
                            <Border Background="#FFFBEB" Padding="20" Margin="0,0,0,16" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🔑 Manual Key Generation" Style="{StaticResource SectionTitle}" Foreground="#92400E"/>
                                    <Button Content="⚡ Generate Key" Command="{Binding GenerateLicenseCommand}" Style="{StaticResource PrimaryBtn}" Width="180" Margin="0,0,0,12"/>
                                    <Border Background="#0F172A" Padding="16" CornerRadius="8">
                                        <TextBox Text="{Binding GeneratedLicenseKey}" Background="Transparent" Foreground="#22C55E" BorderThickness="0" FontFamily="Consolas" FontSize="14" IsReadOnly="True" TextWrapping="Wrap"/>
                                    </Border>
                                    <Button Content="📋 Copy" Command="{Binding CopyLicenseToClipboardCommand}" Style="{StaticResource SecondaryBtn}" Width="140" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Key Format Info -->
                            <Border Background="#F8FAFC" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="ℹ️ Key Format" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                    <TextBlock Text="MEMDS-3M-XXXX-XXXX-XXXX-CHK  •  3 Months" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBlock Text="MEMDS-1Y-XXXX-XXXX-XXXX-CHK  •  1 Year" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBlock Text="MEMDS-LT-XXXX-XXXX-XXXX-CHK  •  Lifetime" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- License Stats -->
                            <WrapPanel>
                                <Border Style="{StaticResource StatCard.Primary}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="📄 Total Licenses" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalLicenses}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Success}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="✅ Active" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding ActiveLicenses}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Purple}" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="📊 Remaining" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding LicenseStatusText}" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- SYSTEM TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=7}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Security -->
                            <Border Background="#FEF2F2" Padding="20" Margin="0,0,0,16" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🔐 Security Settings" Style="{StaticResource SectionTitle}" Foreground="#991B1B"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Session Timeout (min)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SessionTimeoutMinutes}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Failed Logins" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding MaxFailedLoginAttempts}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Password Expiry (days)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding PasswordExpiryDays}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <CheckBox Content="Strong passwords required" IsChecked="{Binding RequireStrongPasswords}" FontSize="12" Foreground="#475569"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Audit logging enabled" IsChecked="{Binding EnableAuditLogging}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Database Backup -->
                            <Border Background="#EFF6FF" Padding="20" Margin="0,0,0,16" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="💾 Database Backup" Style="{StaticResource SectionTitle}" Foreground="#1E40AF"/>
                                    <TextBlock Text="{Binding BackupStatus}" FontSize="12" Foreground="#1E40AF" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="💾 Backup Now" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                        <Button Content="🔄 Restore" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                        <Button Content="🗑️ Cleanup Old" Command="{Binding CleanupOldBackupsCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- System Actions -->
                            <Border Background="#FFF7ED" Padding="20" Margin="0,0,0,16" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🔧 System Actions" Style="{StaticResource SectionTitle}" Foreground="#9A3412"/>
                                    <WrapPanel>
                                        <Button Content="🧹 Clear Cache" Command="{Binding ClearCacheCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="📊 Optimize DB" Command="{Binding OptimizeDatabaseCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="📝 Export Logs" Command="{Binding ExportAuditLogsCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="🚪 Logout All" Command="{Binding ForceLogoutAllCommand}" Style="{StaticResource DangerBtn}" Padding="12,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Reports -->
                            <Border Background="#F0FDF4" Padding="20" Margin="0,0,0,16" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="📊 Reports" Style="{StaticResource SectionTitle}" Foreground="#166534"/>
                                    <WrapPanel>
                                        <Button Content="📄 System Report" Command="{Binding GenerateSystemReportCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="📋 Export Devices" Command="{Binding ExportDeviceReportCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="👥 Export Staff" Command="{Binding ExportStaffReportCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                                        <Button Content="📂 Settings" Command="{Binding LoadSystemSettingsCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- SMTP -->
                            <Border Background="#F8FAFC" Padding="20" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="📧 Email Configuration" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SMTP Server" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SmtpServer}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SmtpPort}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="From Email" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpFromEmail}" Style="{StaticResource ModernInput}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="📧 Test Connection" Command="{Binding TestSmtpConnectionCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,8,0"/>
                                        <Button Content="💾 Save Settings" Command="{Binding SaveSystemSettingsCommand}" Style="{StaticResource PrimaryBtn}" Padding="12,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- System Metrics -->
                            <TextBlock Text="📈 System Metrics" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource StatCard.Purple}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Memory" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding MemoryUsage}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Warning}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="⚡ CPU" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding CpuUsage}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Success}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="👥 Sessions" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding ActiveSessions}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Danger}" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="🚫 Failed Logins (24h)" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding FailedLogins24h}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- System Info -->
                            <WrapPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource StatCard.Primary}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="📦 Database" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding DatabaseSize}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Teal}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="💽 Disk Space" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding DiskSpace}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Slate}" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="⏱️ Uptime" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding SystemUptime}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Backup Stats -->
                            <WrapPanel>
                                <Border Style="{StaticResource StatCard.Success}" Width="200" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Total Backups" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalBackups}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard.Warning}" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="📝 Audit Logs" FontSize="10" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalAuditLogs}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ABOUT TAB -->
                <Border Visibility="{Binding ActiveTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=8}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- App Info -->
                            <Border Background="#0F172A" Padding="24" Margin="0,0,0,16" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🏥 Momen Systems Co." FontSize="22" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Medical Equipment Management System" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,12"/>
                                    <WrapPanel>
                                        <Border Background="#1E293B" Padding="10,6" CornerRadius="6" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SystemVersion}" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <Border Background="#1E293B" Padding="10,6" CornerRadius="6" Margin="0,0,6,4">
                                            <TextBlock Text="© 2026" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <Border Background="#1E293B" Padding="10,6" CornerRadius="6">
                                            <TextBlock Text="CMMS Platform" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Mission -->
                            <Border Background="#F0FDF4" Padding="20" Margin="0,0,0,16" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🎯 Our Mission" FontSize="15" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,8"/>
                                    <TextBlock Text="Empowering healthcare facilities with reliable, compliant medical equipment management." FontSize="12" Foreground="#15803D" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Compliance -->
                            <Border Background="#F8FAFC" Padding="20" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🛡️ Compliance &amp; Standards" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Border Background="#EFF6FF" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="✅ JCI" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                        <Border Background="#EFF6FF" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="✅ ISO 13485" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                        <Border Background="#EFF6FF" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="✅ ISO 14971" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                        <Border Background="#EFF6FF" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="✅ FDA" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                        <Border Background="#EFF6FF" Padding="10,6" CornerRadius="6"><TextBlock Text="✅ NIST" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/></Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tech Stack -->
                            <Border Background="#F8FAFC" Padding="20" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="🧰 Tech Stack" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text=".NET 8" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="WPF" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="EF Core" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="SQLite" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="BCrypt" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,6,4"><TextBlock Text="ClosedXML" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border Background="#F1F5F9" Padding="10,6" CornerRadius="6"><TextBlock Text="QuestPDF" FontSize="11" FontWeight="SemiBold"/></Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Footer -->
                            <Border Background="#0F172A" Padding="20" CornerRadius="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="© 2026 Momen Systems Company" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tel: +249 124 349 024  |  Email: MOHS2N@YAHOO.COM" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== STAFF FORM MODAL OVERLAY ========== -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding ShowStaffForm, Converter={StaticResource BoolToVis}}">
            <Border Width="520" HorizontalAlignment="Right" Margin="0,0,20,20" Background="White" CornerRadius="16" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#3B82F6" Margin="0,0,12,0">
                                <TextBlock Text="{Binding FormIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormTitleText}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding FormSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Command="{Binding CloseFormCommand}" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="18" FontWeight="Bold" Cursor="Hand" Padding="8">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Account Info -->
                        <TextBlock Text="📋 Account Details" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FirstName}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LastName}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Username}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                <Border BorderBrush="#E2E8F0" BorderThickness="1.5" Background="#FAFBFC" CornerRadius="8">
                                    <PasswordBox x:Name="txtPassword" PasswordChanged="TxtPassword_PasswordChanged" Padding="12,10" FontSize="12" FontFamily="Segoe UI" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Email}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Phone}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Role -->
                        <TextBlock Text="🎭 Role" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedItem="{Binding SelectedRole}" Style="{StaticResource ModernCombo}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Administrator"/>
                            <ComboBoxItem Content="Physician"/>
                            <ComboBoxItem Content="Nurse"/>
                            <ComboBoxItem Content="HardwareTechnician"/>
                            <ComboBoxItem Content="ReportWriter"/>
                            <ComboBoxItem Content="BiomedicalEngineer"/>
                            <ComboBoxItem Content="LabTechnician"/>
                            <ComboBoxItem Content="Radiologist"/>
                            <ComboBoxItem Content="ITSupport"/>
                            <ComboBoxItem Content="Receptionist"/>
                            <ComboBoxItem Content="Staff"/>
                        </ComboBox>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Department}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Job Title" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding JobTitle}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Specialization" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Specialization}" Style="{StaticResource ModernInput}" Margin="0,0,0,16"/>

                        <!-- Permissions -->
                        <TextBlock Text="🔑 Permissions" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Manage devices" IsChecked="{Binding CanManageDevices}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage maintenance" IsChecked="{Binding CanManageMaintenance}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage calibration" IsChecked="{Binding CanManageCalibration}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="View reports" IsChecked="{Binding CanViewReports}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Access admin panel" IsChecked="{Binding CanAccessAdminPanel}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage spare parts" IsChecked="{Binding CanManageSpareParts}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage network devices" IsChecked="{Binding CanManageNetworkDevices}" FontSize="12" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage staff" IsChecked="{Binding CanManageStaff}" FontSize="12" Foreground="#475569" Margin="0,4,0,16"/>

                        <!-- Actions -->
                        <Button Content="💾 Save Changes" Command="{Binding SaveStaffCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="✏️ Edit" Command="{Binding StartEditCommand}" CommandParameter="{Binding SelectedStaff}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                            <Button Content="🗑️ Delete" Command="{Binding DeleteStaffCommand}" Style="{StaticResource DangerBtn}" Padding="12,10" Margin="0,0,6,0"/>
                            <Button Content="🔑 Reset Password" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10" Margin="0,0,6,0"/>
                            <Button Content="🔒 Lock/Unlock" Command="{Binding ToggleLockCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,10"/>
                        </WrapPanel>

                        <!-- Status -->
                        <Border Background="#F8FAFC" Padding="14" Margin="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Text" Value="Ready"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
