                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Department}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Job Title" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding JobTitle}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Specialization" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Specialization}" Style="{StaticResource ModernInput}" Margin="0,0,0,14"/>

                        <!-- Permissions -->
                        <TextBlock Text="🔑 Permissions" Style="{StaticResource SectionTitle}"/>

                        <CheckBox Content="Manage devices" IsChecked="{Binding CanManageDevices}" FontSize="11" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage maintenance" IsChecked="{Binding CanManageMaintenance}" FontSize="11" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Manage calibration" IsChecked="{Binding CanManageCalibration}" FontSize="11" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="View reports" IsChecked="{Binding CanViewReports}" FontSize="11" Foreground="#475569" Margin="0,4"/>
                        <CheckBox Content="Access admin panel" IsChecked="{Binding CanAccessAdminPanel}" FontSize="11" Foreground="#475569" Margin="0,4,0,14"/>

                        <!-- Actions -->
                        <Border Background="#F8FAFC" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Button Content="💾 Save" Command="{Binding SaveStaffCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="✏️ Edit" Command="{Binding StartEditCommand}" CommandParameter="{Binding SelectedStaff}" Style="{StaticResource SecondaryBtn}" Padding="10,8" Margin="0,0,6,0"/>
                                    <Button Content="🗑️ Delete" Command="{Binding DeleteStaffCommand}" Style="{StaticResource DangerBtn}" Padding="10,8" Margin="0,0,6,0"/>
                                    <Button Content="🔑 Reset" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,8" Margin="0,0,6,0"/>
                                    <Button Content="🔒 Lock" Command="{Binding ToggleLockCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Status -->
                        <Border Background="#F8FAFC" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#475569" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Text" Value="Ready"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>