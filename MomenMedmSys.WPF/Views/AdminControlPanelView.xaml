<UserControl x:Class="MomenMedmSys.WPF.Views.AdminControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- AdminControlPanelView uses the global styles from ModernStyles.xaml -->
        <!-- Stat cards use: StatCard.Primary, StatCard.Success, StatCard.Danger, etc. -->
        <!-- Buttons use: PrimaryBtn, SecondaryBtn, DangerBtn -->
        <!-- Inputs use: ModernInput, ModernCombo -->
        <!-- Cards use: GlassCard -->
        
        <!-- Pill Tab Bar (unique to this view) -->
        <Style x:Key="ModernTabBar" TargetType="TabItem">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="16">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#60A5FA" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.CornerRadius>
                            <CornerRadius>10</CornerRadius>
                        </Border.CornerRadius>
                        <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Admin Control Panel" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding HospitalName, TargetNullValue='Manage staff, licenses &amp; system settings', FallbackValue='Manage staff, licenses &amp; system settings'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hospital & Admin Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                    <Border Background="#1E293B" Padding="12,8" CornerRadius="8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏥" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding HospitalName}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HospitalName}" Value="">
                                                <Setter Property="Text" Value="No Hospital Configured"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" Padding="12,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AdministratorName}" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdministratorName}" Value="">
                                                <Setter Property="Text" Value="No Administrator Set"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search + Print + Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" Padding="12,8" Width="220" Margin="0,0,8,0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="13" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="12" Padding="0" VerticalAlignment="Center"
                                     Foreground="White"/>
                        </Grid>
                    </Border>
                    <Button Content="🖨️ Print" Command="{Binding PrintReportCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0"
                            BorderBrush="#64748B" Foreground="#E2E8F0">
                        <Button.Background>
                            <SolidColorBrush Color="#334155"/>
                        </Button.Background>
                    </Button>
                    <Button Content="🔄 Refresh" Command="{Binding LoadAllCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Tabs + Content -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Navigation Bar -->
                <Border Grid.Row="0" Background="White" Padding="8,6" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                    <WrapPanel>
                        <TabItem Header="👥 All Staff" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="🔑 Admins" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="🔧 Techs" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="📝 Writers" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="🩺 Doctors" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="💊 Nurses" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="🔐 Licenses" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="⚙️ System" Style="{StaticResource ModernTabBar}"/>
                        <TabItem Header="ℹ️ About" Style="{StaticResource ModernTabBar}"/>
                    </WrapPanel>
                </Border>

                <!-- Tab Content Container -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                    <TabControl Style="{StaticResource {x:Type TabControl}}" SelectedIndex="{Binding ActiveTabIndex}">

                        <!-- ===== ALL STAFF TAB ===== -->
                        <TabItem Header="👥 All Staff" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Data Grid - Primary content at top -->
                                <DataGrid Grid.Row="0" ItemsSource="{Binding FilteredStaff}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" SelectionMode="Single" CanUserSortColumns="True"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="EMP ID" Binding="{Binding EmployeeId}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="120"/>
                                        <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="130"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="110"/>
                                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,4" HorizontalAlignment="Center" CornerRadius="4">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                            <Setter Property="Text" Value="🔒 Locked"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                                                            <Setter Property="Text" Value="✅ Active"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                        <Setter Property="TextElement.Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                                        <Setter Property="TextElement.Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Quick Stats - Bottom summary cards -->
                                <Grid Grid.Row="1" Margin="16,10,16,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatBlue}">
                                        <StackPanel>
                                            <TextBlock Text="👥 Total Staff" FontSize="10" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding TotalStaff}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource StatGreen}">
                                        <StackPanel>
                                            <TextBlock Text="✅ Active" FontSize="10" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding ActiveAccounts}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource StatRed}">
                                        <StackPanel>
                                            <TextBlock Text="🔒 Locked" FontSize="10" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding LockedAccounts}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="6" Style="{StaticResource StatPurple}">
                                        <StackPanel>
                                            <TextBlock Text="🔑 Admins" FontSize="10" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding AdminCount}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== ADMINS TAB ===== -->
                        <TabItem Header="🔑 Admins" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding Administrators}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Stats Bar - Bottom -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="14,10" Margin="16,10,16,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔑 Administrators:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource StatBlue}" Margin="0,0,8,0" MinWidth="100">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Count: " FontSize="10" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Text="{Binding AdminCount}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== TECHNICIANS TAB ===== -->
                        <TabItem Header="🔧 Techs" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding HardwareTechnicians}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                                        <DataGridTextColumn Header="SPECIALIZATION" Binding="{Binding Specialization}" Width="160"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Stats Bar - Bottom -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="14,10" Margin="16,10,16,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔧 Hardware Technicians:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource StatTeal}" Margin="0,0,8,0" MinWidth="100">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Count: " FontSize="10" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Text="{Binding TechnicianCount, TargetNullValue=0}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== REPORT WRITERS TAB ===== -->
                        <TabItem Header="📝 Writers" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding ReportWriters}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="140"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Stats Bar - Bottom -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="14,10" Margin="16,10,16,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝 Report Writers:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource StatPurple}" Margin="0,0,8,0" MinWidth="100">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Count: " FontSize="10" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Text="{Binding WriterCount, TargetNullValue=0}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== PHYSICIANS TAB ===== -->
                        <TabItem Header="🩺 Doctors" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding Physicians}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                                        <DataGridTextColumn Header="SPECIALIZATION" Binding="{Binding Specialization}" Width="180"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Stats Bar - Bottom -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="14,10" Margin="16,10,16,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🩺 Physicians:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource StatRose}" Margin="0,0,8,0" MinWidth="100">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Count: " FontSize="10" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Text="{Binding PhysicianCount, TargetNullValue=0}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== NURSES TAB ===== -->
                        <TabItem Header="💊 Nurses" Style="{StaticResource ModernTabBar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding Nurses}" SelectedItem="{Binding SelectedStaff}"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Margin="16,16,16,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="140"/>
                                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Stats Bar - Bottom -->
                                <Border Grid.Row="1" Background="#F8FAFC" Padding="14,10" Margin="16,10,16,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💊 Nurses:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Style="{StaticResource StatIndigo}" Margin="0,0,8,0" MinWidth="100">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Count: " FontSize="10" Foreground="White" Opacity="0.9"/>
                                                <TextBlock Text="{Binding NurseCount, TargetNullValue=0}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== LICENSES TAB ===== -->
                        <TabItem Header="🔐 Licenses" Style="{StaticResource ModernTabBar}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                <StackPanel>
                                    <!-- License Generation Card - Primary content -->
                                    <Border Background="#F5F3FF" Padding="16" Margin="0,0,0,10" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="🚀 License Generation" Style="{StaticResource SectionTitle}" Foreground="#5B21B6"/>
                                            <TextBlock Text="LICENSE NUMBER" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding InputLicenseNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,10" FontFamily="Consolas" FontSize="13"/>
                                            <TextBlock Text="DURATION" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedIndex="{Binding SelectedLicenseTypeIndex}" Style="{StaticResource ModernCombo}" Margin="0,0,0,10">
                                                <ComboBoxItem Content="3 Months (90 days)"/>
                                                <ComboBoxItem Content="1 Year (365 days)"/>
                                                <ComboBoxItem Content="Lifetime (Unlimited)"/>
                                            </ComboBox>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Content="📄 License File" Command="{Binding GenerateLicenseFileCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,10" Margin="0,0,8,0"/>
                                                <Button Content="🚀 Update System" Command="{Binding UpdateSystemCommand}" Padding="14,10" Margin="0,0,8,0">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#10B981" Offset="0"/>
                                                            <GradientStop Color="#059669" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                                <Button Content="📦 Distribution" Command="{Binding GenerateDistributionPackageCommand}" Padding="14,10">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="#5B21B6" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DistributionStatus}" FontSize="11" Foreground="#7C3AED" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Manual Key Generation -->
                                    <Border Background="#FFFBEB" Padding="16" Margin="0,0,0,10" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="🔑 Manual Key Generation" Style="{StaticResource SectionTitle}" Foreground="#92400E"/>
                                            <Button Content="⚡ Generate Key" Command="{Binding GenerateLicenseCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Margin="0,0,0,10"/>
                                            <Border Background="#0F172A" Padding="14" CornerRadius="8">
                                                <TextBox Text="{Binding GeneratedLicenseKey}" Background="Transparent" Foreground="#22C55E" BorderThickness="0" FontFamily="Consolas" FontSize="14" IsReadOnly="True" TextWrapping="Wrap"/>
                                            </Border>
                                            <Button Content="📋 Copy" Command="{Binding CopyLicenseToClipboardCommand}" Style="{StaticResource SecondaryBtn}" Width="120" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Key Format Info -->
                                    <Border Background="#F8FAFC" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="ℹ️ Key Format" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBlock Text="MEMDS-3M-XXXX-XXXX-XXXX-CHK  •  3 Months" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
