<UserControl x:Class="MomenMedmSys.WPF.Views.WorkOrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32" MaxWidth="960">

            <!-- Page Header -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,20" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0F172A">
                            <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Work Order"/>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold"><Run Text="{Binding Mode, Mode=OneWay}"/></TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Add">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="TextElement.Foreground" Value="#1E40AF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Edit">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>

            <!-- Section: Work Order Details -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Primary}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Work Order Details" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Reporter, priority, assignment and scheduling" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Reported By" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ReportedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Device Category" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DeviceCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Assigned To" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Scheduled Start" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding ScheduledStartDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Scheduled End" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding ScheduledEndDate}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2">
                            <CheckBox Content="External Contractor" IsChecked="{Binding IsExternalContractor}" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="14" Foreground="#334155"/>
                            <TextBlock Text="Contractor Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ContractorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section: Fault Description -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Danger}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Fault &amp; Root Cause" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Describe the problem and its underlying cause" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Fault Description *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FaultDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>
                        <TextBlock Text="Root Cause" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RootCause, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section: Resolution & Costs -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" Margin="0,0,0,16">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{StaticResource Gradient.Stat.Success}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Resolution &amp; Costs" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Fix details and financial breakdown" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Estimated Cost ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EstimatedCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Actual Cost ($)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ActualCost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Resolution Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ResolutionDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Padding="12,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,18">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/></Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryBtn}" Width="110" Padding="14,10" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Padding="14,10">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Work Order"/></TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
