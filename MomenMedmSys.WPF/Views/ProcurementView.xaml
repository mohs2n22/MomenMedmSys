<UserControl x:Class="MomenMedmSys.WPF.Views.ProcurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Procurement Requests" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Manage equipment procurement and purchase orders" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" 
                      Width="160" Padding="8,6" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0"/>

            <Button Content="➕ Add" Command="{Binding AddRequestCommand}" Style="{StaticResource PrimaryBtn}" Width="90" Margin="0,0,8,0"/>
            <Button Content="✏️ Edit" Command="{Binding EditRequestCommand}" Style="{StaticResource SecondaryBtn}" Width="90" Margin="0,0,8,0"/>
            <Button Content="🗑️ Delete" Command="{Binding DeleteRequestCommand}" Style="{StaticResource SecondaryBtn}" Width="90" Margin="0,0,8,0"/>
            <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}" Width="100"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding ProcurementRequests}" 
                  Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Request #" Binding="{Binding RequestNumber}" Width="120"/>
                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="180"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="120"/>
                <DataGridTextColumn Header="Request Date" Binding="{Binding RequestDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="Estimated Cost" Binding="{Binding EstimatedCost, StringFormat=C}" Width="120"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="TextElement.Foreground" Value="#475569"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="TextElement.Foreground" Value="#166534"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Setter Property="TextElement.Foreground" Value="#991B1B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12"/>
            <TextBlock Text=" | " Foreground="#CBD5E1" FontSize="12"/>
            <TextBlock Foreground="#64748B" FontSize="12">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Total: {0} | Pending: {1} | Approved: {2}">
                        <Binding Path="TotalCount"/>
                        <Binding Path="PendingCount"/>
                        <Binding Path="ApprovedCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

