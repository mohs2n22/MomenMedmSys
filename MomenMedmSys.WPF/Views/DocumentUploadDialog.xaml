<Window x:Class="MomenMedmSys.WPF.Views.DocumentUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters"
        Title="Upload Document" 
        Width="550" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Drag Drop Zone Style -->
        <Style x:Key="DropZoneStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                    <Setter Property="Background" Value="#E3F2FD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#1E293B">
                        <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" Document"/>
                    </TextBlock>
                    <TextBlock Text="Upload or update device documentation" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Error Message -->
                <Border Background="#FEE2E2" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Device Selection -->
                <TextBlock Text="Device *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedValuePath="Id" SelectedValue="{Binding DeviceId}" 
                          DisplayMemberPath="DeviceName" Padding="10,8" FontSize="14" 
                          BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16"/>

                <!-- Document Name -->
                <TextBlock Text="Document Name *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,16"/>

                <!-- Document Type -->
                <TextBlock Text="Document Type *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding DocumentType}" Padding="10,8" FontSize="14" 
                          BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                    <ComboBoxItem Content="OperationManual"/>
                    <ComboBoxItem Content="MaintenanceManual"/>
                    <ComboBoxItem Content="WarrantyCertificate"/>
                    <ComboBoxItem Content="TrainingMaterial"/>
                    <ComboBoxItem Content="RegulatoryCertificate"/>
                    <ComboBoxItem Content="CalibrationCertificate"/>
                    <ComboBoxItem Content="SafetyTestReport"/>
                    <ComboBoxItem Content="TechnicalDrawing"/>
                    <ComboBoxItem Content="SoftwareManual"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- File Selection -->
                <TextBlock Text="File" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                
                <!-- Drop Zone -->
                <Border Style="{StaticResource DropZoneStyle}" Margin="0,0,0,8"
                        AllowDrop="True"
                        Drop="DropZone_Drop"
                        DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave"
                        MouseLeftButtonDown="DropZone_MouseLeftButtonDown">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4C1;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#94A3B8"/>
                        <TextBlock Text="Drag &amp; drop file here or click to browse" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="Maximum file size: 50 MB" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        
                        <!-- Selected File Info -->
                        <StackPanel Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <Border Background="#E3F2FD" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x2705;" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SelectedFileName}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Browse Button -->
                <Button Content="&#x1F4C2; Browse Files" Command="{Binding BrowseFileCommand}" 
                        Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" 
                        Width="140" Margin="0,0,0,16"/>

                <!-- Version -->
                <TextBlock Text="Version" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,16"/>

                <!-- Expiry Date -->
                <TextBlock Text="Expiry Date (Optional)" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ExpiryDate}" Padding="10,8" FontSize="14" 
                            BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8"/>
                <CheckBox Content="Is current version" IsChecked="{Binding IsCurrentVersion}" 
                          FontSize="13" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="Description" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Padding="10,8" Height="70" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" 
                            Style="{StaticResource SecondaryBtn}" Width="100" Margin="0,0,12,0"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" 
                            Style="{StaticResource PrimaryBtn}" Width="120"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

