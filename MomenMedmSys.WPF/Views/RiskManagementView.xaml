<UserControl x:Class="MomenMedmSys.WPF.Views.RiskManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EF4444" Width="40" Height="40" Margin="0,0,14,0"><TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Risk Management" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Manage risk incidents and safety reports (ISO 14971)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" Padding="12,9" Width="240" Margin="0,0,12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="🖨️ Export " Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0" Click="ExportDropdown_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📊 Export to Excel" Command="{Binding ExportToExcelCommand}"/>
                                <MenuItem Header="📄 Export to CSV" Command="{Binding ExportToCsvCommand}"/>
                                <MenuItem Header="📑 Export to PDF" Command="{Binding ExportToPdfCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="🔄 Refresh" Command="{Binding LoadIncidentsCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Stats Cards -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource StatCard.Danger}">
                    <StackPanel><TextBlock Text="⚠️ Open Incidents" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding OpenIncidentsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Purple}">
                    <StackPanel><TextBlock Text="🔴 Critical" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding CriticalIncidentsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Warning}">
                    <StackPanel><TextBlock Text="🟡 High Risk" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding HighRiskCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Success}">
                    <StackPanel><TextBlock Text="✅ Closed" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding ClosedCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </WrapPanel>

            <!-- Data Grid Card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <TextBlock Text="⚡ Actions:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="➕ Add Incident" Command="{Binding AddIncidentCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="✏️ Edit" Command="{Binding EditIncidentCommand}" CommandParameter="{Binding SelectedIncident}" Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Delete" Command="{Binding DeleteIncidentCommand}" CommandParameter="{Binding SelectedIncident}" Style="{StaticResource DangerBtn}" Padding="14,9" Margin="0,0,16,0"/>
                            <TextBlock Text="Risk Level:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Text="{Binding FilterRiskLevel, UpdateSourceTrigger=PropertyChanged}" Width="130" Style="{StaticResource ModernCombo}">
                                <ComboBoxItem Content="All Levels"/><ComboBoxItem Content="Critical"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Low"/>
                            </ComboBox>
                            <ComboBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" Width="140" Style="{StaticResource ModernCombo}" Margin="12,0,0,0">
                                <ComboBoxItem Content="All Statuses"/><ComboBoxItem Content="Open"/><ComboBoxItem Content="UnderInvestigation"/><ComboBoxItem Content="Closed"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredIncidents}" SelectedItem="{Binding SelectedIncident}" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding IncidentCode}" Width="110">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="140"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding IncidentDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="PROBABILITY" Binding="{Binding Probability}" Width="90"/>
                            <DataGridTemplateColumn Header="RISK LEVEL" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="95">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding OverallRisk}" Value="Critical"><Setter Property="Text" Value="🔴 Critical"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding OverallRisk}" Value="High"><Setter Property="Text" Value="🟡 High"/><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding OverallRisk}" Value="Medium"><Setter Property="Text" Value="🔵 Medium"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding OverallRisk}" Value="Low"><Setter Property="Text" Value="🟢 Low"/><Setter Property="Foreground" Value="#059669"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding OverallRisk}" Value="Critical"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding OverallRisk}" Value="High"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                                <DataTrigger Binding="{Binding OverallRisk}" Value="Medium"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                                                <DataTrigger Binding="{Binding OverallRisk}" Value="Low"><Setter Property="Background" Value="#D1FAE5"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="120">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Open"><Setter Property="Text" Value="🔓 Open"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="UnderInvestigation"><Setter Property="Text" Value="🔍 Investigating"/><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Closed"><Setter Property="Text" Value="✅ Closed"/><Setter Property="Foreground" Value="#059669"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Open"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="UnderInvestigation"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Closed"><Setter Property="Background" Value="#D1FAE5"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="White" Padding="14,10" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12"/>
                    <TextBlock Grid.Column="1" Foreground="#64748B" FontSize="12">
                        <TextBlock.Text><MultiBinding StringFormat="Showing {0} of {1} incidents"><Binding Path="FilteredIncidents.Count"/><Binding Path="Incidents.Count"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
