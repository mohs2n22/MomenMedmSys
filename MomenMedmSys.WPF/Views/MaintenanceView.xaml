<UserControl x:Class="MomenMedmSys.WPF.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F59E0B" Width="40" Height="40" Margin="0,0,14,0"><TextBlock Text="🔧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Maintenance" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Manage equipment maintenance schedules and records" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" Padding="12,9" Width="240" Margin="0,0,12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="🖨️ Export " Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0" Click="ExportDropdown_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📊 Export to Excel" Command="{Binding ExportToExcelCommand}"/>
                                <MenuItem Header="📄 Export to CSV" Command="{Binding ExportToCsvCommand}"/>
                                <MenuItem Header="📑 Export to PDF" Command="{Binding ExportToPdfCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="🔄 Refresh" Command="{Binding LoadRecordsCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="{StaticResource Space.4}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Stats Cards -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource StatCard.Primary}">
                    <StackPanel><TextBlock Text="📋 Total Records" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Records.Count}" Foreground="White" Style="{StaticResource MetricValue}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Success}">
                    <StackPanel><TextBlock Text="✅ Completed" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CompletedCount}" Foreground="White" Style="{StaticResource MetricValue}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Danger}">
                    <StackPanel><TextBlock Text="⚠️ Overdue" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding OverdueCount}" Foreground="White" Style="{StaticResource MetricValue}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard.Warning}">
                    <StackPanel><TextBlock Text="📅 Scheduled" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding ScheduledCount}" Foreground="White" Style="{StaticResource MetricValue}"/></StackPanel>
                </Border>
            </WrapPanel>

            <!-- Data Grid Card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource Bg.SurfaceAlt}" Padding="16,12" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <TextBlock Text="⚡ Actions:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="➕ Add Record" Command="{Binding AddRecordCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="✏️ Edit" Command="{Binding EditRecordCommand}" CommandParameter="{Binding SelectedRecord}" Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <TextBlock Text="Type:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Text="{Binding FilterType, UpdateSourceTrigger=PropertyChanged}" Width="130" Style="{StaticResource ModernCombo}">
                                <ComboBoxItem Content="All Types"/><ComboBoxItem Content="Preventive"/><ComboBoxItem Content="Corrective"/><ComboBoxItem Content="Emergency"/><ComboBoxItem Content="Inspection"/>
                            </ComboBox>
                            <ComboBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" Width="140" Style="{StaticResource ModernCombo}" Margin="12,0,0,0">
                                <ComboBoxItem Content="All Statuses"/><ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="InProgress"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Overdue"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRecords}" SelectedItem="{Binding SelectedRecord}" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="TYPE" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="105">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Preventive"><Setter Property="Text" Value="🔵 Preventive"/><Setter Property="Foreground" Value="{StaticResource Color.Blue.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Corrective"><Setter Property="Text" Value="🟡 Corrective"/><Setter Property="Foreground" Value="{StaticResource Color.Warning.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Emergency"><Setter Property="Text" Value="🔴 Emergency"/><Setter Property="Foreground" Value="{StaticResource Color.Danger.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inspection"><Setter Property="Text" Value="🟢 Inspection"/><Setter Property="Foreground" Value="{StaticResource Color.Success.600}"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Preventive"><Setter Property="Background" Value="{StaticResource Color.Blue.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Corrective"><Setter Property="Background" Value="{StaticResource Color.Warning.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Emergency"><Setter Property="Background" Value="{StaticResource Color.Danger.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Inspection"><Setter Property="Background" Value="{StaticResource Color.Success.100}"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="160"/>
                            <DataGridTextColumn Header="SCHEDULED" Binding="{Binding ScheduledDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="COMPLETED" Binding="{Binding CompletedDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="PERFORMED BY" Binding="{Binding PerformedBy}" Width="130"/>
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="105">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Text" Value="✅ Completed"/><Setter Property="Foreground" Value="{StaticResource Color.Success.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Scheduled"><Setter Property="Text" Value="📅 Scheduled"/><Setter Property="Foreground" Value="{StaticResource Color.Blue.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress"><Setter Property="Text" Value="🔧 In Progress"/><Setter Property="Foreground" Value="{StaticResource Color.Warning.600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Overdue"><Setter Property="Text" Value="⚠️ Overdue"/><Setter Property="Foreground" Value="{StaticResource Color.Danger.600}"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Background" Value="{StaticResource Color.Success.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Scheduled"><Setter Property="Background" Value="{StaticResource Color.Blue.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="InProgress"><Setter Property="Background" Value="{StaticResource Color.Warning.100}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Overdue"><Setter Property="Background" Value="{StaticResource Color.Danger.100}"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LABOR" Binding="{Binding LaborCost, StringFormat={}{0:C0}}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PARTS" Binding="{Binding PartsCost, StringFormat={}{0:C0}}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalCost, StringFormat={}{0:C0}}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Color.Success.600}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource Bg.Surface}" Padding="14,10" Margin="0,12,0,0" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Foreground="#64748B" FontSize="12">
                        <TextBlock.Text><MultiBinding StringFormat="Showing {0} of {1} records"><Binding Path="FilteredRecords.Count"/><Binding Path="Records.Count"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
