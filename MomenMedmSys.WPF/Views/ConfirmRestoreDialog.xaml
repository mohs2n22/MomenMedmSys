<Window x:Class="MomenMedmSys.WPF.Views.ConfirmRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Restore"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Warning Icon -->
            <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="12,12,0,0" Padding="24,20">
                <StackPanel Orientation="Horizontal">
                    <!-- Warning Triangle Icon -->
                    <Canvas Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="M16 2L2 28h28L16 2zm0 8v8m0 4v2" Stroke="#92400E" StrokeThickness="2.5" Fill="None" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="14" Canvas.Top="22" Width="4" Height="4" Fill="#92400E"/>
                    </Canvas>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Confirm Database Restore" FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                        <TextBlock Text="This is a destructive operation" FontSize="12" Foreground="#78350F" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Warning Message -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <Border Background="#FEE2E2" CornerRadius="6" BorderBrush="#FECACA" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#9888;&#xFE0F;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="All data changed or created since this backup will be permanently lost."
                                   FontSize="13" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="You are about to restore from:" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="File:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="BackupFileName" Text="—" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="BackupDate" Text="—" Foreground="#1E293B" FontSize="12"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Size:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Grid.Column="1" x:Name="BackupSize" Text="—" Foreground="#1E293B" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="The application will need to restart after the restore completes."
                           FontSize="12" Foreground="#64748B" Margin="0,12,0,0" FontStyle="Italic"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                <Button Content="Cancel" Click="CancelButton_Click"
                        Width="100" Padding="12,8" FontSize="13" Margin="0,0,12,0"
                        Background="White" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Yes, Restore" x:Name="RestoreButton" Click="RestoreButton_Click"
                        Width="130" Padding="12,8" FontSize="13" FontWeight="SemiBold"
                        Background="#DC2626" Foreground="White" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
