<UserControl x:Class="MomenMedmSys.WPF.Views.AdvancedDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:lvc2="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:NullToVisibilityCollapsed x:Key="NullToVisibilityCollapsed"/>

            <!-- View-specific overrides -->
            <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}"/>
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSize.3xl}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            </Style>

            <Style x:Key="MetricSubText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Xs}"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.6}">
            <!-- Toolbar / Header -->
            <Border Style="{StaticResource GlassCard}" Padding="{StaticResource Space.4}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Analytics Dashboard" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Period:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DateRangeCombo" ItemsSource="{Binding DateRangeOptions}"
                                  SelectedItem="{Binding SelectedDateRange, Mode=TwoWay}"
                                  Width="140" Margin="0,0,12,0" Style="{StaticResource ModernCombo}"/>

                        <Button Content="&#x21BB; Refresh" Command="{Binding LoadAllDataCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                        <Button Content="&#x1F4C5; Export Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI Cards Section -->
            <WrapPanel Margin="0,0,0,16">
                <!-- Equipment Availability -->
                <Border Style="{StaticResource StatCard.Success}">
                    <StackPanel>
                        <TextBlock Text="Availability" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding EquipmentAvailability, StringFormat={}{0:N1}%}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Operational uptime" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- MTBF -->
                <Border Style="{StaticResource StatCard.Primary}">
                    <StackPanel>
                        <TextBlock Text="MTBF" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Mtbf, StringFormat={}{0:N1} d}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Mean Time Failures" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- MTTR -->
                <Border Style="{StaticResource StatCard.Warning}">
                    <StackPanel>
                        <TextBlock Text="MTTR" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Mttr, StringFormat={}{0:N1} h}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Mean Time Repair" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- Maintenance Completion Rate -->
                <Border Style="{StaticResource StatCard.Teal}">
                    <StackPanel>
                        <TextBlock Text="Completion" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MaintenanceCompletionRate, StringFormat={}{0:N1}%}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="On-time tasks" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- Calibration Compliance -->
                <Border Style="{StaticResource StatCard.Indigo}">
                    <StackPanel>
                        <TextBlock Text="Compliance" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding CalibrationCompliance, StringFormat={}{0:N1}%}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Calibration" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- Open Work Orders -->
                <Border Style="{StaticResource StatCard.Purple}">
                    <StackPanel>
                        <TextBlock Text="Open WOs" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OpenWorkOrders}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Active orders" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>

                <!-- Overdue Items -->
                <Border Style="{StaticResource StatCard.Danger}">
                    <StackPanel>
                        <TextBlock Text="Overdue" Foreground="White" Opacity="0.9" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding OverdueItems}" Foreground="White" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="Needs attention" Foreground="White" Opacity="0.7" Style="{StaticResource MetricSubText}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts Section -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Maintenance Trend -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Maintenance Trend - Last 12 Months" Style="{StaticResource SectionTitle}"/>
                        <lvc:CartesianChart Series="{Binding MaintenanceTrendSeries}" Height="300" LegendPosition="Bottom" XAxes="{Binding MaintenanceTrendXAxis}" YAxes="{Binding MaintenanceTrendYAxis}"/>
                    </StackPanel>
                </Border>

                <!-- Device Status -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Device Status Distribution" Style="{StaticResource SectionTitle}"/>
                        <lvc:PieChart Series="{Binding DeviceStatusSeries}" Height="280" InitialRotation="-90" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <!-- Department Costs -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Department Cost Comparison" Style="{StaticResource SectionTitle}"/>
                        <lvc:CartesianChart Series="{Binding DepartmentCostSeries}" Height="280" LegendPosition="Bottom" XAxes="{Binding DepartmentCostXAxis}" YAxes="{Binding DepartmentCostYAxis}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tables Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top 10 Failing Equipment -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Top Failing Equipment" Style="{StaticResource SectionTitle}"/>
                        <DataGrid ItemsSource="{Binding TopFailingEquipment}" Style="{StaticResource ModernDataGrid}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*"/>
                                <DataGridTextColumn Header="Dept" Binding="{Binding Department}" Width="1*"/>
                                <DataGridTextColumn Header="Maint." Binding="{Binding MaintenanceCount}" Width="0.7*"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding TotalCost, StringFormat={}{0:C2}}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Warranty Expiry -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Warranty Expiry Timeline" Style="{StaticResource SectionTitle}"/>
                        <DataGrid ItemsSource="{Binding WarrantyExpiryTimeline}" Style="{StaticResource ModernDataGrid}" Height="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quarter" Binding="{Binding Quarter}" Width="*"/>
                                <DataGridTextColumn Header="Devices" Binding="{Binding DeviceCount}" Width="0.7*"/>
                                <DataGridTextColumn Header="List" Binding="{Binding DeviceList}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
