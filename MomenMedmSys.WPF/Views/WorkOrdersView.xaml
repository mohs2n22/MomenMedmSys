<UserControl x:Class="MomenMedmSys.WPF.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1400">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" Width="40" Height="40" Margin="0,0,14,0"><TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Work Orders" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Track fault reports and repair requests" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" Padding="12,9" Width="240" Margin="0,0,12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="🔄 Refresh" Command="{Binding LoadWorkOrdersCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Stats Cards -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource StatCardBlue}">
                    <StackPanel><TextBlock Text="📋 Total Work Orders" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding WorkOrders.Count}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardGreen}">
                    <StackPanel><TextBlock Text="🔓 Open" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding OpenCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardRed}">
                    <StackPanel><TextBlock Text="⏰ Overdue" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding OverdueCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardPurple}">
                    <StackPanel><TextBlock Text="⚡ Emergency" FontSize="10" Foreground="White" Opacity="0.9"/><TextBlock Text="{Binding EmergencyCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </WrapPanel>

            <!-- Data Grid Card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <TextBlock Text="⚡ Actions:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="➕ Add Work Order" Command="{Binding AddWorkOrderCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="✏️ Edit" Command="{Binding EditWorkOrderCommand}" CommandParameter="{Binding SelectedWorkOrder}" Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Delete" Command="{Binding DeleteWorkOrderCommand}" CommandParameter="{Binding SelectedWorkOrder}" Style="{StaticResource DangerBtn}" Padding="14,9" Margin="0,0,16,0"/>
                            <TextBlock Text="Priority:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Text="{Binding FilterPriority, UpdateSourceTrigger=PropertyChanged}" Width="120" Style="{StaticResource ModernCombo}">
                                <ComboBoxItem Content="All Priorities"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Emergency"/>
                            </ComboBox>
                            <ComboBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" Width="140" Style="{StaticResource ModernCombo}" Margin="12,0,0,0">
                                <ComboBoxItem Content="All Statuses"/><ComboBoxItem Content="Open"/><ComboBoxItem Content="InProgress"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredWorkOrders}" SelectedItem="{Binding SelectedWorkOrder}" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WO NUMBER" Binding="{Binding WorkOrderNumber}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="160">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="FAULT DESCRIPTION" Binding="{Binding FaultDescription}" Width="*"/>
                            <DataGridTextColumn Header="REPORT DATE" Binding="{Binding ReportDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedTo}" Width="120"/>
                            <DataGridTemplateColumn Header="PRIORITY" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="95">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Emergency"><Setter Property="Text" Value="🔴 Emergency"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="High"><Setter Property="Text" Value="🟠 High"/><Setter Property="Foreground" Value="#EA580C"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Medium"><Setter Property="Text" Value="🟡 Medium"/><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Low"><Setter Property="Text" Value="🟢 Low"/><Setter Property="Foreground" Value="#059669"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="Emergency"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="High"><Setter Property="Background" Value="#FFF7ED"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Medium"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Low"><Setter Property="Background" Value="#D1FAE5"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="110">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Open"><Setter Property="Text" Value="🔓 Open"/><Setter Property="Foreground" Value="#2563EB"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress"><Setter Property="Text" Value="🔧 In Progress"/><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Text" Value="✅ Completed"/><Setter Property="Foreground" Value="#059669"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Text" Value="❌ Cancelled"/><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Open"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="InProgress"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Background" Value="#D1FAE5"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#F1F5F9"/></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="EST. COST" Binding="{Binding EstimatedCost, StringFormat={}{0:C0}}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="White" Padding="14,10" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12"/>
                    <TextBlock Grid.Column="1" Foreground="#64748B" FontSize="12">
                        <TextBlock.Text><MultiBinding StringFormat="Showing {0} of {1} work orders"><Binding Path="FilteredWorkOrders.Count"/><Binding Path="WorkOrders.Count"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
