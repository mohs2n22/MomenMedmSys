<UserControl x:Class="MomenMedmSys.WPF.Views.ServicesDocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1600" d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <!-- ServicesDocView uses global styles (GlassCard, SectionTitle) from ModernStyles.xaml -->
        <!-- Plus these view-specific styles: -->
        
        <Style x:Key="ServiceCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="MethodItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
        <StackPanel Margin="32,24,32,40" MaxWidth="1060">

            <!-- HEADER -->
            <Border Style="{StaticResource GlassCard}" Padding="36">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#0F172A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#3B82F6" Width="64" Height="64" CornerRadius="16" Margin="0,0,20,0">
                        <TextBlock Text="🛠️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Services Documentation" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#93C5FD" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- OVERVIEW -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="📋 Overview" Style="{StaticResource SectionTitle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#475569" LineHeight="22">
                        MomenMedmSys is built on a clean 4-layer architecture (Core → Data → Services → WPF) with 26 in-process business services.
                        Each service encapsulates a specific domain area and is registered via dependency injection. Services communicate through
                        interfaces, enabling testability and loose coupling. There are no REST APIs or Windows services — everything runs
                        in-process as a single desktop application.
                    </TextBlock>
                    <WrapPanel Margin="0,16,0,0">
                        <Border Background="#EFF6FF" Padding="14,10" CornerRadius="8" Margin="0,0,8,6">
                            <StackPanel>
                                <TextBlock Text="26" FontSize="22" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Services" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" Padding="14,10" CornerRadius="8" Margin="0,0,8,6">
                            <StackPanel>
                                <TextBlock Text="8" FontSize="22" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                <TextBlock Text="Categories" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF3C7" Padding="14,10" CornerRadius="8" Margin="0,0,8,6">
                            <StackPanel>
                                <TextBlock Text="4" FontSize="22" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Layers" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FDF2F8" Padding="14,10" CornerRadius="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#9D174D" HorizontalAlignment="Center"/>
                                <TextBlock Text="Executable" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ARCHITECTURE DIAGRAM -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="🏗️ Architecture" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Layer boxes -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#EFF6FF" Padding="16" CornerRadius="10" BorderBrush="#BFDBFE" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎨 WPF Presentation" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Views + ViewModels" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="▼" FontSize="20" Foreground="#94A3B8" Margin="12,0" VerticalAlignment="Center"/>
                        <Border Grid.Row="0" Grid.Column="2" Background="#FEF3C7" Padding="16" CornerRadius="10" BorderBrush="#FDE68A" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚙️ Services Layer" FontSize="13" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Text="26 Business Services" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#F0FDF4" Padding="16" CornerRadius="10" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🗃️ Data Layer" FontSize="13" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                <TextBlock Text="EF Core + SQLite" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="▼" FontSize="20" Foreground="#94A3B8" Margin="12,0" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Grid.Column="2" Background="#F5F3FF" Padding="16" CornerRadius="10" BorderBrush="#DDD6FE" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧱 Core Domain" FontSize="13" FontWeight="Bold" Foreground="#5B21B6" HorizontalAlignment="Center"/>
                                <TextBlock Text="Entities + Enums (0 deps)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SERVICE DETAIL CARDS (grouped by category) -->
            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <!-- Category Header -->
                            <Border Padding="16,10" Margin="0,0,0,12" CornerRadius="10">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Color, TargetNullValue=#3B82F6}" Opacity="0.1"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding Color, TargetNullValue=#3B82F6}" Opacity="0.3"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>
                                    <Thickness>1</Thickness>
                                </Border.BorderThickness>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding Color, TargetNullValue=#3B82F6}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>

                            <!-- Services in this category -->
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ServiceCard}">
                                            <StackPanel>
                                                <!-- Service Name & Interface -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding InterfaceName}" FontSize="12" Foreground="#64748B" FontFamily="Consolas" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#D1FAE5" Padding="8,4" CornerRadius="6"
                                                            VerticalAlignment="Top" MaxWidth="180">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Compliance}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Compliance}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="#059669"
                                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                                <!-- Methods -->
                                                <TextBlock Text="Methods:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding Methods}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource MethodItem}">
                                                                <Run Text="• " Foreground="#94A3B8"/><Run Text="{Binding}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Used By -->
                                                <WrapPanel Margin="0,12,0,0">
                                                    <TextBlock Text="Used by:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ItemsControl ItemsSource="{Binding UsedBy}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F1F5F9" Padding="6,3" CornerRadius="4" Margin="0,0,4,3">
                                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#475569"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>

                                                <!-- Notes -->
                                                <Border Background="#FFF7ED" Padding="12,8" CornerRadius="8" Margin="0,10,0,0" BorderBrush="#FED7AA" BorderThickness="1">
                                                    <TextBlock FontSize="11" Foreground="#9A3412">
                                                        <Run Text="💡 " FontWeight="Bold"/><Run Text="{Binding Notes}"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- FOOTER -->
            <Border Background="#0F172A" Padding="24" CornerRadius="12" TextElement.Foreground="White">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="© 2026 Momen Systems Company. All Rights Reserved." FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tel: +249 124 349 024 — Email: MOHS2N@YAHOO.COM" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
