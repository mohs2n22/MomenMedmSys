<UserControl x:Class="MomenMedmSys.WPF.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MomenMedmSys.WPF.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Audit Trail" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Complete history of all changes made in the system" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Date Range Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <DatePicker SelectedDate="{Binding StartDate}" Width="160" Margin="0,0,16,0"
                        BorderBrush="#E2E8F0" BorderThickness="1"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="160" Margin="0,0,16,0"
                        BorderBrush="#E2E8F0" BorderThickness="1"/>
            <Button Content="Apply Dates" Command="{Binding LoadAuditLogsCommand}"
                    Style="{StaticResource SecondaryBtn}" Width="100"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" Padding="8,6" FontSize="14"
                     BorderBrush="#E2E8F0" BorderThickness="1" VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="&#x1F50D;" FontSize="16" Margin="-28,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"/>

            <TextBlock Text="Entity:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#64748B"/>
            <ComboBox ItemsSource="{Binding EntityTypes}" Text="{Binding FilterEntityType, UpdateSourceTrigger=PropertyChanged}"
                      Width="160" Padding="8,6" FontSize="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0"/>

            <TextBlock Text="Action:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <ComboBox Text="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}" Width="120" Padding="8,6" FontSize="14"
                      BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Create"/>
                <ComboBoxItem Content="Update"/>
                <ComboBoxItem Content="Delete"/>
            </ComboBox>

            <Button Content="&#x2795; View Details" Command="{Binding ViewDetailsCommand}" Style="{StaticResource PrimaryBtn}" Width="110" Margin="0,0,8,0"/>
            <Button Content="&#x1F4C1; Export" Command="{Binding ExportToExcelCommand}" Style="{StaticResource SecondaryBtn}" Width="100" Margin="0,0,8,0"/>
            <Button Content="&#x274C; Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryBtn}" Width="90" Margin="0,0,8,0"/>
            <Button Content="&#x1F504; Refresh" Command="{Binding LoadAuditLogsCommand}" Style="{StaticResource SecondaryBtn}" Width="100"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredAuditLogs}" SelectedItem="{Binding SelectedAuditLog}"
                  Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="Entity Type" Binding="{Binding EntityType}" Width="140"/>
                <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="80"/>
                <DataGridTemplateColumn Header="Action" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="Create">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Update">
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Create">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}" Value="Create">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="Update">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Action}" Value="Delete">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="130"/>
                <DataGridTextColumn Header="Affected Records" Binding="{Binding AffectedRecords}" Width="200"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12"/>
            <TextBlock Text=" | " Foreground="#CBD5E1" FontSize="12"/>
            <TextBlock Foreground="#64748B" FontSize="12">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Showing {0} of {1} entries">
                        <Binding Path="FilteredAuditLogs.Count"/>
                        <Binding Path="AuditLogs.Count"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

