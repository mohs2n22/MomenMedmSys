<UserControl x:Class="MomenMedmSys.WPF.Views.UserFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MomenMedmSys.WPF.Converters">

    <UserControl.Resources>
        <converters:InverseBoolToEnabledConverter x:Key="InverseBoolToEnabled"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Info -->
        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
            <Border Width="120" Height="120" CornerRadius="60" Background="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="&#x1F464;" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Opacity="0.8"/>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="Create or edit system user accounts" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right Panel: Form -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundWhite}" CornerRadius="12"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Account Details" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>

                    <!-- Username -->
                    <TextBlock Text="Username *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,14"
                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBoolToEnabled}}"/>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Email -->
                    <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Password (only shown for new users or when resetting) -->
                    <TextBlock FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Password *"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Password (leave blank to keep current)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" Margin="0,0,0,14"
                                 BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14" FontFamily="Segoe UI"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8" Margin="0,0,0,14"
                                 BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14" FontFamily="Segoe UI"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                    <!-- Role -->
                    <TextBlock Text="Role *" FontSize="12" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole, UpdateSourceTrigger=PropertyChanged}"
                              Padding="10,8" Margin="0,0,0,14" FontSize="14"/>

                    <!-- Active -->
                    <CheckBox Content="Account is active" IsChecked="{Binding IsActive}"
                              Foreground="#374151" FontSize="13" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="&#x1F4BE; Save" Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryBtn}" Width="100" Margin="0,0,8,0"/>
                        <Button Content="&#x2716;&#xFE0F; Cancel" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryBtn}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

