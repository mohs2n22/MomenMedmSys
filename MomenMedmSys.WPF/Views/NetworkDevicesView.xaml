<UserControl x:Class="MomenMedmSys.WPF.Views.NetworkDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Device List + Discovery -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="🌐 Network Devices" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Discover, monitor, and remotely manage network-connected medical devices" FontSize="14" Foreground="#64748B"/>
            </StackPanel>

            <!-- Status Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#22C55E" CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🟢 Online: " Foreground="White" FontSize="12"/><TextBlock Text="{Binding OnlineCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Background="#EF4444" CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔴 Offline: " Foreground="White" FontSize="12"/><TextBlock Text="{Binding OfflineCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Background="#F59E0B" CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🟡 Warning: " Foreground="White" FontSize="12"/><TextBlock Text="{Binding WarningCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Background="#6366F1" CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="📊 Total: " Foreground="White" FontSize="12"/><TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel>
                </Border>
                <Button Content="🔄 Refresh Status" Command="{Binding RefreshStatusCommand}" Style="{StaticResource PrimaryBtn}" Width="130" Margin="8,0,8,0"/>
                <Button Content="🗑️ Delete" Command="{Binding DeleteDeviceCommand}" Style="{StaticResource SecondaryBtn}" Width="80"/>
            </StackPanel>

            <!-- Device List -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionMode="Single" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Online">
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Warning">
                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                    <Setter Property="Fill" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="150"/>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="130"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="110"/>
                    <DataGridTextColumn Header="Firmware" Binding="{Binding FirmwareVersion}" Width="100"/>
                    <DataGridTextColumn Header="Response" Binding="{Binding ResponseTimeMs, StringFormat={}{0}ms}" Width="80"/>
                    <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="Remote Mgmt" Binding="{Binding RemoteManagementEnabled}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Status -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/>
        </Grid>

        <!-- Right Panel: Device Details + Remote Actions -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Device Detail Header -->
                    <TextBlock Text="Device Details" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <StackPanel>
                        <!-- Basic Info -->
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDevice.DeviceName}" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Foreground="#64748B" FontSize="12" Margin="0,4,0,0">
                                    <Run Text="{Binding SelectedDevice.Manufacturer}"/><Run Text=" "/><Run Text="{Binding SelectedDevice.Model}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedDevice.ConnectionStatusDisplay}" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tabs: Network | Status | Actions | Logs -->
                        <TabControl SelectedIndex="{Binding DetailTabIndex}">
                            <!-- Network Tab -->
                            <TabItem Header="🔌 Network">
                                <StackPanel Margin="0,8">
                                    <TextBlock Text="IP Address" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="MAC Address" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.MacAddress}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="Hostname" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.Hostname}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="Port" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.Port}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="Gateway" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.Gateway}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="Discovery Method" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.DiscoveredVia}" FontSize="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="First Discovered" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedDevice.FirstDiscovered, StringFormat=yyyy-MM-dd HH:mm}" FontSize="14" Margin="0,2,0,8"/>
                                </StackPanel>
                            </TabItem>

                            <!-- Status Tab -->
                            <TabItem Header="📊 Status">
                                <StackPanel Margin="0,8">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="CPU Usage" FontSize="12" Foreground="#64748B"/>
                                            <ProgressBar Value="{Binding SelectedDevice.CpuUsage}" Maximum="100" Height="8" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding SelectedDevice.CpuUsage, StringFormat={}{0:F1}%}" FontSize="12" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Memory Usage" FontSize="12" Foreground="#64748B"/>
                                            <ProgressBar Value="{Binding SelectedDevice.MemoryUsage}" Maximum="100" Height="8" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding SelectedDevice.MemoryUsage, StringFormat={}{0:F1}%}" FontSize="12" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Disk Usage" FontSize="12" Foreground="#64748B"/>
                                            <ProgressBar Value="{Binding SelectedDevice.DiskUsage}" Maximum="100" Height="8" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding SelectedDevice.DiskUsage, StringFormat={}{0:F1}%}" FontSize="12" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Active Connections" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SelectedDevice.ActiveConnections}" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="System Health" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" Margin="0,8,0,4"/>
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedDevice.SystemHealthStatus}" FontSize="14" FontWeight="SemiBold"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDevice.SystemHealthStatus}" Value="Healthy">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Setter Property="TextElement.Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDevice.SystemHealthStatus}" Value="Warning">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDevice.SystemHealthStatus}" Value="Critical">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="TextElement.Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="Uptime" FontSize="12" Foreground="#64748B" Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding SelectedDevice.UptimeHours, StringFormat={}{0} hours}" FontSize="14"/>
                                    <TextBlock Text="Open Ports" FontSize="12" Foreground="#64748B" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding SelectedDevice.OpenPorts}" FontSize="14" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>

                            <!-- Remote Actions Tab -->
                            <TabItem Header="🎮 Remote Actions">
                                <StackPanel Margin="0,8">
                                    <!-- Security Info -->
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10" Margin="0,0,0,12" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🔐 Security" FontWeight="SemiBold" Foreground="#1E40AF" FontSize="12"/>
                                            <TextBlock FontSize="11" Foreground="#1E40AF" Margin="0,4,0,0">
                                                <Run Text="Auth: "/><Run Text="{Binding SelectedDevice.AuthenticationMethod}"/><Run Text=" | SSL: "/><Run Text="{Binding SelectedDevice.SslEnabled}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Selector -->
                                    <TextBlock Text="Action Type" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding SelectedActionType}" Padding="8,6" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Ping"/>
                                        <ComboBoxItem Content="GetStatus"/>
                                        <ComboBoxItem Content="GetDiagnostics"/>
                                        <ComboBoxItem Content="Reboot"/>
                                        <ComboBoxItem Content="UpdateFirmware"/>
                                        <ComboBoxItem Content="UpdateSoftware"/>
                                        <ComboBoxItem Content="GetConfiguration"/>
                                        <ComboBoxItem Content="SetConfiguration"/>
                                        <ComboBoxItem Content="RestartService"/>
                                        <ComboBoxItem Content="GetLogs"/>
                                        <ComboBoxItem Content="ClearLogs"/>
                                        <ComboBoxItem Content="Backup"/>
                                        <ComboBoxItem Content="Restore"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>

                                    <TextBlock Text="Parameters (JSON)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionParameters, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                                    <!-- Capability Flags -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <CheckBox Content="Updates" IsChecked="{Binding SelectedDevice.SupportsRemoteUpdate}" IsEnabled="False" Margin="0,0,12,0"/>
                                        <CheckBox Content="Diagnostics" IsChecked="{Binding SelectedDevice.SupportsRemoteDiagnostics}" IsEnabled="False" Margin="0,0,12,0"/>
                                        <CheckBox Content="Config" IsChecked="{Binding SelectedDevice.SupportsRemoteConfiguration}" IsEnabled="False" Margin="0,0,12,0"/>
                                        <CheckBox Content="Reboot" IsChecked="{Binding SelectedDevice.SupportsRemoteReboot}" IsEnabled="False"/>
                                    </StackPanel>

                                    <Button Content="▶ Execute Action" Command="{Binding ExecuteActionCommand}" Style="{StaticResource PrimaryBtn}" Width="160" HorizontalAlignment="Left"/>

                                    <!-- Result -->
                                    <TextBlock Text="{Binding ActionResultMessage}" Foreground="#64748B" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>

                            <!-- Action Logs Tab -->
                            <TabItem Header="📝 Action Logs">
                                <StackPanel Margin="0,8">
                                    <Button Content="🔄 Refresh Logs" Command="{Binding LoadActionLogsCommand}" Style="{StaticResource SecondaryBtn}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding ActionLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ActionType}" FontWeight="SemiBold" FontSize="13"/>
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding Result}" FontSize="10" FontWeight="SemiBold"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Result}" Value="Success">
                                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                                <Setter Property="TextElement.Foreground" Value="#166534"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Result}" Value="Failed">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                                <Setter Property="TextElement.Foreground" Value="#991B1B"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Result}" Value="InProgress">
                                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                                <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding ActionDescription}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding ExecutedBy, StringFormat=By: {0}}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="10" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>

                    <!-- No device selected -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center" Foreground="#CBD5E1" Margin="0,40,0,16"/>
                        <TextBlock Text="Select a network device to view details and perform remote actions" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Network Discovery Section -->
                    <Separator Margin="0,20,0,20"/>
                    <TextBlock Text="🔍 Network Discovery" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Text="{Binding SubnetInput, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="8,6" FontSize="13"
                                 BorderBrush="#E2E8F0" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBlock Text="(subnet, e.g. 192.168.1.1)" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="8,0,0,0"/>
                        <Button Content="📡 Scan" Command="{Binding ScanNetworkCommand}" Style="{StaticResource PrimaryBtn}" Width="80" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Discovered Devices -->
                    <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F0FDF4" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="#BBF7D0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" FontSize="13" Foreground="#166534"/>
                                            <TextBlock Text="{Binding ResponseTimeMs, StringFormat={}{0}ms response}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="➕ Add" Padding="8,4" FontSize="11"
                                                Style="{StaticResource PrimaryBtn}" Command="{Binding DataContext.ImportSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

