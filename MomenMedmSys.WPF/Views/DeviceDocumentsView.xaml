<UserControl x:Class="MomenMedmSys.WPF.Views.DeviceDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Device Documents" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Manage medical equipment documentation" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- Device Filter -->
            <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" 
                      Width="200" Padding="8,6" FontSize="13" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0"
                      DisplayMemberPath="DeviceName" SelectedValuePath="Id">
                <ComboBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>

            <!-- Document Type Filter -->
            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
            <ComboBox Text="{Binding FilterDocumentType, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="8,6" FontSize="13"
                      BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="OperationManual"/>
                <ComboBoxItem Content="MaintenanceManual"/>
                <ComboBoxItem Content="WarrantyCertificate"/>
                <ComboBoxItem Content="TrainingMaterial"/>
                <ComboBoxItem Content="RegulatoryCertificate"/>
                <ComboBoxItem Content="CalibrationCertificate"/>
                <ComboBoxItem Content="SafetyTestReport"/>
                <ComboBoxItem Content="TechnicalDrawing"/>
                <ComboBoxItem Content="SoftwareManual"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>

            <!-- Search Box -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,6" FontSize="13"
                     BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0"
                     VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="&#x1F50D;" FontSize="14" Margin="-24,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"/>

            <!-- Action Buttons -->
            <Button Content="&#x2795; Add" Command="{Binding AddDocumentCommand}" Style="{StaticResource PrimaryBtn}" Width="80" Margin="0,0,8,0"/>
            <Button Content="&#x270F;&#xFE0F; Edit" Command="{Binding EditDocumentCommand}" Style="{StaticResource SecondaryBtn}" Width="80" Margin="0,0,8,0"/>
            <Button Content="&#x1F5D1;&#xFE0F; Delete" Command="{Binding DeleteDocumentCommand}" Style="{StaticResource SecondaryBtn}" Width="90" Margin="0,0,8,0"/>
            <Button Content="&#x1F441; View" Command="{Binding ViewDocumentCommand}" Style="{StaticResource SecondaryBtn}" Width="80" Margin="0,0,8,0"/>
            <Button Content="&#x1F4C5; Export Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource SecondaryBtn}" Width="120" Margin="0,0,8,0"/>
            <Button Content="&#x1F504; Refresh" Command="{Binding LoadDocumentsCommand}" Style="{StaticResource SecondaryBtn}" Width="100"/>
        </StackPanel>

        <!-- Main Content: DataGrid + Details Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: DataGrid -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <DataGrid ItemsSource="{Binding FilteredDocuments}" SelectedItem="{Binding SelectedDocument}"
                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                          SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Type" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#x1F4C4;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="OperationManual">
                                                        <Setter Property="Text" Value="&#x1F4D6;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="MaintenanceManual">
                                                        <Setter Property="Text" Value="&#x1F4D6;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="WarrantyCertificate">
                                                        <Setter Property="Text" Value="&#x1F6E1;&#xFE0F;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="TrainingMaterial">
                                                        <Setter Property="Text" Value="&#x1F4D6;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="RegulatoryCertificate">
                                                        <Setter Property="Text" Value="&#x1F4DC;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="CalibrationCertificate">
                                                        <Setter Property="Text" Value="&#x1F4DC;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="SafetyTestReport">
                                                        <Setter Property="Text" Value="&#x1F4CB;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="TechnicalDrawing">
                                                        <Setter Property="Text" Value="&#x1F4CA;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentType}" Value="SoftwareManual">
                                                        <Setter Property="Text" Value="&#x1F4D6;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Document Name" Binding="{Binding FileName}" Width="200"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
                        <DataGridTextColumn Header="File Size" Binding="{Binding FileSizeDisplay}" Width="85"/>
                        <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="Uploaded By" Binding="{Binding UploadedBy}" Width="110"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Current"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentVersion}" Value="False">
                                                            <Setter Property="Text" Value="Archived"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                            <Setter Property="Text" Value="Expired"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="TextElement.Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentVersion}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Setter Property="TextElement.Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="TextElement.Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Document Details Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Panel Header -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Document Details" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="Select a document to view details" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Details Content -->
                        <StackPanel Visibility="{Binding DocumentDetailsVisible}">
                            <!-- Document Type Icon & Name -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding DocumentTypeIcon}" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DocumentTypeName}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Document Info -->
                            <TextBlock Text="File Information" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.FileName}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDocument.Version}" FontSize="12" Foreground="#1E293B"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="File Size:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDocument.FileSizeDisplay}" FontSize="12" Foreground="#1E293B"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Upload Date:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedDocument.UploadDate, StringFormat=yyyy-MM-dd HH:mm}" FontSize="12" Foreground="#1E293B"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Uploaded By:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedDocument.UploadedBy}" FontSize="12" Foreground="#1E293B"/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Expiry Date:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" FontSize="12" Foreground="#1E293B">
                                    <TextBlock.Text>
                                        <Binding Path="SelectedDocument.ExpiryDate" StringFormat="yyyy-MM-dd" TargetNullValue="N/A"/>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Current Ver.:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Yes"/>
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDocument.IsCurrentVersion}" Value="False">
                                                    <Setter Property="Text" Value="No"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="14" Grid.Column="0" Text="File Path:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedDocument.FilePath}" FontSize="11" Foreground="#1976D2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- Description/Notes -->
                            <TextBlock Text="Description" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,8,0,8"/>
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedDocument.Description}" FontSize="12" Foreground="#1E293B" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDocument.Description}" Value="">
                                                    <Setter Property="Text" Value="No description provided"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Preview Area -->
                            <TextBlock Text="Preview" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="16" Height="120" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F4C4;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Click View to open file" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- No Selection Placeholder -->
                        <StackPanel Visibility="{Binding NoDocumentSelectedVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                            <TextBlock Text="&#x1F4C4;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#CBD5E1"/>
                            <TextBlock Text="No document selected" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a document from the list to view details" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12"/>
            <TextBlock Text=" | " Foreground="#CBD5E1" FontSize="12"/>
            <TextBlock Text="{Binding StatusBarText}" Foreground="#64748B" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>

