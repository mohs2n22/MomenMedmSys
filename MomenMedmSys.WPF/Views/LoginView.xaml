<Window x:Class="MomenMedmSys.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - MomenMedmSys"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="LoginView_KeyDown"
        MouseLeftButtonDown="Border_MouseLeftButtonDown">

    <Border CornerRadius="{StaticResource Radius.Lg}" BorderThickness="1" BorderBrush="{StaticResource Color.Slate.700}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E293B" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.8">
                                    <DoubleAnimation.EasingFunction>
                                        <PowerEase Power="4" EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform/>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>

        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" Content="X" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="32" Height="32" FontSize="{StaticResource FontSize.Base}" FontWeight="Bold"
                    Background="Transparent" Foreground="{StaticResource Color.Slate.400}"
                    BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>

            <!-- Logo -->
            <Image Grid.Row="1" Source="/MomenMedmSys.WPF;component/Assets/AppIcon.ico"
                   Width="80" Height="80" Margin="0,16,0,24"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#3B82F6" Opacity="0.3" ShadowDepth="0"/>
                </Image.Effect>
            </Image>

            <!-- Title -->
            <TextBlock Grid.Row="2" Text="MomenMedmSys" FontSize="{StaticResource FontSize.3xl}" FontWeight="Bold"
                        Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="3" Text="Medical Equipment Management System" FontSize="{StaticResource FontSize.Base}"
                        Foreground="{StaticResource Color.Slate.400}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

            <!-- Error Message -->
            <Border Grid.Row="4" Background="{StaticResource Color.Danger.900}" CornerRadius="{StaticResource Radius.Md}" Padding="12,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Color.Danger.200}" FontSize="{StaticResource FontSize.Sm}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Border>

            <!-- Username -->
            <TextBlock Grid.Row="5" Text="Username" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Color.Slate.200}"/>
            <Border Grid.Row="6" BorderBrush="{StaticResource Color.Slate.700}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Bg.Sidebar}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" FontSize="16" Margin="12,0,8,0"
                               VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                              Background="Transparent" BorderThickness="0" Padding="0,12"
                              Foreground="White" FontSize="{StaticResource FontSize.Base}" FontFamily="{StaticResource Font.Default}"
                              VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Password -->
            <TextBlock Grid.Row="7" Text="Password" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Color.Slate.200}"/>
            <Border Grid.Row="8" BorderBrush="{StaticResource Color.Slate.700}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Bg.Sidebar}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" FontSize="16" Margin="12,0,8,0"
                               VerticalAlignment="Center" Opacity="0.6"/>
                    <PasswordBox Grid.Column="1" x:Name="PasswordBox"
                                 Background="Transparent" BorderThickness="0" Padding="0,12"
                                 Foreground="White" FontSize="{StaticResource FontSize.Base}" FontFamily="{StaticResource Font.Default}"
                                 VerticalContentAlignment="Center" PasswordChanged="PasswordBox_PasswordChanged"/>
                </Grid>
            </Border>

            <!-- Remember Me & Loading -->
            <Grid Grid.Row="9" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="Keep me signed in" Foreground="{StaticResource Color.Slate.400}" FontSize="{StaticResource FontSize.Sm}"
                          IsChecked="{Binding RememberMe}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Logging in..." Foreground="{StaticResource Color.Primary.400}" FontSize="{StaticResource FontSize.Sm}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Login Button -->
            <Button Grid.Row="10" Content="Sign In"
                    Click="SignInButton_Click"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    Height="50" IsDefault="True"/>
        </Grid>
    </Border>
</Window>
