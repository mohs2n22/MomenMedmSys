<UserControl x:Class="MomenMedmSys.WPF.Views.NotificationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:MomenMedmSys.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:NotificationPanelViewModel}"
             Width="420" MaxHeight="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="0,0,0,12" BorderThickness="1,0,1,1" BorderBrush="#E2E8F0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="16" ShadowDepth="0" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22M18 16V11C18 7.9 16.4 5.1 14 4.3V3.5C14 2.7 13.3 2 12.5 2C11.7 2 11 2.7 11 3.5V4.3C8.6 5.1 7 7.9 7 11V16L5 18V19H19V18L18 16Z"
                              Fill="White" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#EF4444" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0"
                                Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UnreadCount}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClosePanelCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Width="28" Height="28">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="14">
                                    <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z"
                                          Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mark All Read" Command="{Binding MarkAllAsReadCommand}" FontSize="11" Padding="12,4"
                                Background="Transparent" Foreground="#1976D2" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notification List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="itemBorder" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                  Command="{Binding DataContext.NavigateToEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Priority indicator -->
                                    <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Margin="0,2,8,2" Fill="#94A3B8">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                        <Setter Property="Fill" Value="#1976D2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                        <Setter Property="Fill" Value="#F57C00"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                        <Setter Property="Fill" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                        <Setter Property="Fill" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="#E2E8F0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                <Setter Property="Fill" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#1E293B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B"
                                                   TextWrapping="Wrap" MaxHeight="36" Margin="14,2,0,0"/>
                                        <TextBlock FontSize="10" Foreground="#94A3B8" Margin="14,4,0,0">
                                            <Run Text="{Binding Type}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd, HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Delete button -->
                                    <Button Grid.Column="2" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="Transparent" BorderThickness="0" Width="24" Height="24" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="12">
                                                    <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z"
                                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading State -->
            <Grid Grid.Row="2" Background="#F8FAFC" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Loading notifications..." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <TextBlock FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center">
                    <Run Text="{Binding Notifications.Count, StringFormat='{}{0} notifications'}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding UnreadCount, StringFormat='{}{0} unread'}"/>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>
