<UserControl x:Class="MomenMedmSys.WPF.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Device Register" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Manage medical equipment inventory" FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" Padding="8,6" FontSize="14"
                     BorderBrush="#E2E8F0" BorderThickness="1" VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="🔍" FontSize="16" Margin="-28,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"/>

            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#64748B"/>
            <ComboBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="8,6" FontSize="14"
                      BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="UnderMaintenance"/>
                <ComboBoxItem Content="OutOfService"/>
                <ComboBoxItem Content="PendingCalibration"/>
                <ComboBoxItem Content="Decommissioned"/>
                <ComboBoxItem Content="Disposed"/>
            </ComboBox>

            <Button Content="➕ Add" Command="{Binding AddDeviceCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="90" Margin="0,0,8,0"/>
            <Button Content="✏️ Edit" Command="{Binding EditDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"/>
            <Button Content="🗑️ Delete" Command="{Binding DeleteDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0"/>
            <Button Content="🔄 Refresh" Command="{Binding LoadDevicesCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}"
                  Style="{StaticResource DataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding DeviceCode}" Width="90"/>
                <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="200"/>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="130"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="100"/>
                <DataGridTextColumn Header="Serial No." Binding="{Binding SerialNumber}" Width="120"/>
                <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="Risk Class" Binding="{Binding RiskClassification}" Width="80"/>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="OutOfService">
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="PendingCalibration">
                                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OutOfService">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PendingCalibration">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12"/>
            <TextBlock Text=" | " Foreground="#CBD5E1" FontSize="12"/>
            <TextBlock Foreground="#64748B" FontSize="12">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Showing {0} of {1} devices">
                        <Binding Path="FilteredDevices.Count"/>
                        <Binding Path="Devices.Count"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
