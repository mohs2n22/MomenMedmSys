<UserControl x:Class="MomenMedmSys.WPF.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- DeviceListView uses global styles from ModernStyles.xaml -->
        <!-- StatCard: Base style with custom gradient overrides per instance -->
        <!-- Other styles (GlassCard, Buttons, Inputs, DataGrid) use global versions -->
        
        <!-- Base Stat Card Style - gradients overridden per instance -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" Width="40" Height="40" Margin="0,0,14,0">
                        <TextBlock Text="🏥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Device Register" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Manage medical equipment inventory" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search + Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" Padding="12,9" Width="260" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="13" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="🔄 Refresh" Command="{Binding LoadDevicesCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stats Cards Row -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="🏥 Total Devices" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding Devices.Count}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="✅ Active" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#D97706" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="🔧 Under Maintenance" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding MaintenanceCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EF4444" Offset="0"/>
                            <GradientStop Color="#DC2626" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="⚠️ Critical Risk" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding CriticalCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="💰 Total Asset Value" FontSize="10" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalAssetValue}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Data Grid Card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <TextBlock Text="⚡ Quick Actions:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="➕ Add Device" Command="{Binding AddDeviceCommand}" Style="{StaticResource PrimaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="✏️ Edit" Command="{Binding EditDeviceCommand}" CommandParameter="{Binding SelectedDevice}" Style="{StaticResource SecondaryBtn}" Padding="14,9" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Delete" Command="{Binding DeleteDeviceCommand}" CommandParameter="{Binding SelectedDevice}" Style="{StaticResource DangerBtn}" Padding="14,9" Margin="0,0,16,0"/>
                            <TextBlock Text="Filters:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" Width="160" Style="{StaticResource ModernCombo}" Margin="0,0,12,0">
                                <ComboBoxItem Content="All Statuses"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="UnderMaintenance"/>
                                <ComboBoxItem Content="OutOfService"/>
                                <ComboBoxItem Content="PendingCalibration"/>
                                <ComboBoxItem Content="Decommissioned"/>
                                <ComboBoxItem Content="Disposed"/>
                            </ComboBox>
                            <ComboBox Text="{Binding FilterDepartment, UpdateSourceTrigger=PropertyChanged}" Width="180" Style="{StaticResource ModernCombo}" Margin="0,0,12,0">
                                <ComboBoxItem Content="All Departments"/>
                                <ComboBoxItem Content="Radiology"/>
                                <ComboBoxItem Content="Intensive Care Unit"/>
                                <ComboBoxItem Content="Central Laboratory"/>
                                <ComboBoxItem Content="Emergency Room"/>
                                <ComboBoxItem Content="Operating Theatre"/>
                                <ComboBoxItem Content="Sterilization (CSSD)"/>
                                <ComboBoxItem Content="Physiotherapy"/>
                                <ComboBoxItem Content="Dialysis Unit"/>
                                <ComboBoxItem Content="Neonatal ICU (NICU)"/>
                                <ComboBoxItem Content="Anesthesiology"/>
                                <ComboBoxItem Content="Outpatient Department"/>
                                <ComboBoxItem Content="Biomedical Engineering"/>
                            </ComboBox>
                            <Button Content="📋 Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,9"/>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEVICE CODE" Binding="{Binding DeviceCode}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DEVICE NAME" Binding="{Binding DeviceName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="140"/>
                            <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="140"/>
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Room}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PURCHASE PRICE" Binding="{Binding PurchasePrice, StringFormat={}{0:C0}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="WARRANTY" Binding="{Binding WarrantyExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="RISK" Binding="{Binding RiskClassification}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RiskClassification}" Value="Critical">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskClassification}" Value="High">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskClassification}" Value="Medium">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RiskClassification}" Value="Low">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Width="120">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Text" Value="✅ Active"/>
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                                <Setter Property="Text" Value="🔧 In Maintenance"/>
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OutOfService">
                                                                <Setter Property="Text" Value="❌ Out of Service"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="PendingCalibration">
                                                                <Setter Property="Text" Value="📏 Pending Calibration"/>
                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="UnderMaintenance">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OutOfService">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PendingCalibration">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="White" Padding="14,10" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12"/>
                    <TextBlock Grid.Column="1" Foreground="#64748B" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Showing {0} of {1} devices">
                                <Binding Path="FilteredDevices.Count"/>
                                <Binding Path="Devices.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
