<UserControl x:Class="MomenMedmSys.WPF.Controls.NotificationToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:MomenMedmSys.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModel:NotificationToastViewModel}"
             Width="380" MinHeight="100" Margin="0,0,0,12">
    <UserControl.Resources>
        <Style x:Key="ToastBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="0" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ToastBorderStyle}" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding HandleClickCommand}"/>
        </Border.InputBindings>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <!-- Priority Color Bar -->
            <Rectangle Grid.Column="0" RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding PriorityColor, TargetNullValue=#1976D2}"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Icon -->
            <Border Grid.Column="1" Margin="8,12,0,12" VerticalAlignment="Top">
                <Border Background="{Binding PriorityColor, TargetNullValue=#1976D2, Converter={StaticResource Placeholder}}" Width="36" Height="36" CornerRadius="18">
                    <Path Data="{Binding PriorityIcon}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="2" Margin="12,12,8,12" VerticalAlignment="Top">
                <TextBlock Text="{Binding Notification.Title}" FontSize="13" FontWeight="SemiBold" 
                           Foreground="#1E293B" TextWrapping="Wrap" MaxHeight="40"/>
                <TextBlock Text="{Binding Notification.Message}" FontSize="12" 
                           Foreground="#64748B" TextWrapping="Wrap" MaxHeight="60" Margin="0,4,0,0"/>
                <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0">
                    <Run Text="{Binding Notification.Type, StringFormat='Type: {0}'}"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding Notification.CreatedAt, StringFormat='{}{0:MMM dd, HH:mm}'}"/>
                </TextBlock>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="3" Command="{Binding CloseCommand}" 
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Width="28" Height="28" Margin="0,4,4,0" VerticalAlignment="Top"
                    ToolTip="Dismiss">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="14">
                            <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12Z" 
                                  Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
