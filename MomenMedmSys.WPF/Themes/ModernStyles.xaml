    <!-- ========================================== -->
    <!-- 3. SPACING SCALE (4px Base Unit) -->
    <!-- ========================================== -->
    
    <!-- Spacing values as Thickness for margins/padding -->
    <Thickness x:Key="Space.0">0</Thickness>
    <Thickness x:Key="Space.1">4</Thickness>
    <Thickness x:Key="Space.2">8</Thickness>
    <Thickness x:Key="Space.3">12</Thickness>
    <Thickness x:Key="Space.4">16</Thickness>
    <Thickness x:Key="Space.5">20</Thickness>
    <Thickness x:Key="Space.6">24</Thickness>
    <Thickness x:Key="Space.8">32</Thickness>
    <Thickness x:Key="Space.10">40</Thickness>
    <Thickness x:Key="Space.12">48</Thickness>

    <!-- ========================================== -->
    <!-- 4. SHADOW SYSTEM -->
    <!-- ========================================== -->
    
    <!-- Subtle shadow for cards -->
    <DropShadowEffect x:Key="Shadow.Sm" Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.05" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Md" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Lg" Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270"/>
    
    <!-- Colored shadows for stat cards (matching gradient color) -->
    <DropShadowEffect x:Key="Shadow.Primary" Color="#3B82F6" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Success" Color="#10B981" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Warning" Color="#F59E0B" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Danger" Color="#EF4444" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Purple" Color="#8B5CF6" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Teal" Color="#14B8A6" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Indigo" Color="#6366F1" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Rose" Color="#F43F5E" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Slate" Color="#475569" BlurRadius="10" ShadowDepth="2" Opacity="0.20" Direction="270"/>

    <!-- ========================================== -->
    <!-- 5. CORNER RADIUS SCALE -->
    <!-- ========================================== -->
    
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
    <CornerRadius x:Key="Radius.2xl">24</CornerRadius>

    <!-- ========================================== -->
    <!-- 6. TYPOGRAPHY SCALE -->
    <!-- ========================================== -->
    
    <FontFamily x:Key="Font.Default">Segoe UI</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSize.Xs" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
    <sys:Double x:Key="FontSize.Sm" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSize.Base" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSize.Lg" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSize.Xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSize.2xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSize.3xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>

    <!-- ========================================== -->
    <!-- 7. STAT CARD GRADIENT BRUSHES (Uniform Distribution) -->
    <!-- ========================================== -->
    
    <!-- These use a consistent gradient pattern: lighter shade (400) -> darker shade (700) -->
    <!-- This ensures uniform appearance across all card types -->
    
    <LinearGradientBrush x:Key="Gradient.Stat.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#60A5FA" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Success" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4ADE80" Offset="0"/>
        <GradientStop Color="#15803D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Warning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#B45309" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Danger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F87171" Offset="0"/>
        <GradientStop Color="#B91C1C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Purple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C084FC" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Teal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Indigo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#818CF8" Offset="0"/>
        <GradientStop Color="#4338CA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Rose" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB7185" Offset="0"/>
        <GradientStop Color="#BE123C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Stat.Slate" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0"/>
        <GradientStop Color="#334155" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========================================== -->
    <!-- 8. COMPONENT STYLES -->
    <!-- ========================================== -->

    <!-- Glass Card - Main container card -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Space.6}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Lg}"/>
    </Style>

    <!-- Section Title -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Field Label -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Modern Input -->
    <Style x:Key="ModernInput" TargetType="TextBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
        <Setter Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{StaticResource Radius.Md}" Padding="2">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Border.Focus}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Color.Slate.300}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern ComboBox -->
    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
        <Setter Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{StaticResource Radius.Md}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Margin="12,10,0,10" 
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource Text.Secondary}"
                                  Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Popup Grid.Column="0" x:Name="Popup" AllowsTransparency="True" 
                                   Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" BorderBrush="{StaticResource Border.Default}" 
                                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" 
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Border.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.Primary.500}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.OnPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Primary.600}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Primary.700}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Border.Focus}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Primary.500}"/>
                            <Setter Property="Background" Value="{StaticResource Color.Primary.50}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Color.Slate.100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Danger.500}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Danger.200}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Color.Danger.50}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Color.Danger.500}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Color.Danger.100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solid Primary Button (for forms) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"/>
    
    <!-- Solid Secondary Button (for forms) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}"/>
    
    <!-- Solid Danger Button (for forms) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerBtn}"/>

    <!-- Modern DataGrid -->
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg.SurfaceAlt}"/>
        <Setter Property="RowBackground" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border.Light}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Bg.SurfaceAlt}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid Style (legacy support) -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ========================================== -->
    <!-- 9. STAT CARD STYLES (Uniform Design) -->
    <!-- ========================================== -->
    
    <!-- Base Stat Card Style - all stat cards inherit from this -->
    <Style x:Key="StatCard.Base" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MaxWidth" Value="170"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Md}"/>
    </Style>

    <!-- Stat Cards - Each uses consistent gradient pattern with colored shadow -->
    <Style x:Key="StatCard.Primary" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Primary}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Primary}"/>
    </Style>

    <Style x:Key="StatCard.Success" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Success}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Success}"/>
    </Style>

    <Style x:Key="StatCard.Warning" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Warning}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Warning}"/>
    </Style>

    <Style x:Key="StatCard.Danger" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Danger}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Danger}"/>
    </Style>

    <Style x:Key="StatCard.Purple" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Purple}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Purple}"/>
    </Style>

    <Style x:Key="StatCard.Teal" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Teal}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Teal}"/>
    </Style>

    <Style x:Key="StatCard.Indigo" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Indigo}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Indigo}"/>
    </Style>

    <Style x:Key="StatCard.Rose" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Rose}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Rose}"/>
    </Style>

    <Style x:Key="StatCard.Slate" TargetType="Border" BasedOn="{StaticResource StatCard.Base}">
        <Setter Property="Background" Value="{StaticResource Gradient.Stat.Slate}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Slate}"/>
    </Style>

    <!-- Legacy stat card names (for backward compatibility) -->
    <Style x:Key="StatCardBlue" TargetType="Border" BasedOn="{StaticResource StatCard.Primary}"/>
    <Style x:Key="StatCardGreen" TargetType="Border" BasedOn="{StaticResource StatCard.Success}"/>
    <Style x:Key="StatCardAmber" TargetType="Border" BasedOn="{StaticResource StatCard.Warning}"/>
    <Style x:Key="StatCardRed" TargetType="Border" BasedOn="{StaticResource StatCard.Danger}"/>
    <Style x:Key="StatCardPurple" TargetType="Border" BasedOn="{StaticResource StatCard.Purple}"/>
    <Style x:Key="StatCardTeal" TargetType="Border" BasedOn="{StaticResource StatCard.Teal}"/>
    <Style x:Key="StatCardIndigo" TargetType="Border" BasedOn="{StaticResource StatCard.Indigo}"/>

    <!-- AdminControlPanelView legacy names (StatBlue, StatGreen, etc.) -->
    <Style x:Key="StatBlue" TargetType="Border" BasedOn="{StaticResource StatCard.Primary}"/>
    <Style x:Key="StatGreen" TargetType="Border" BasedOn="{StaticResource StatCard.Success}"/>
    <Style x:Key="StatRed" TargetType="Border" BasedOn="{StaticResource StatCard.Danger}"/>
    <Style x:Key="StatPurple" TargetType="Border" BasedOn="{StaticResource StatCard.Purple}"/>
    <Style x:Key="StatAmber" TargetType="Border" BasedOn="{StaticResource StatCard.Warning}"/>
    <Style x:Key="StatTeal" TargetType="Border" BasedOn="{StaticResource StatCard.Teal}"/>
    <Style x:Key="StatRose" TargetType="Border" BasedOn="{StaticResource StatCard.Rose}"/>
    <Style x:Key="StatSlate" TargetType="Border" BasedOn="{StaticResource StatCard.Slate}"/>

    <!-- ========================================== -->
    <!-- 10. BADGE STYLES -->
    <!-- ========================================== -->
    
    <Style x:Key="Badge.Base" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="Badge.Success" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Success.100}"/>
    </Style>

    <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Warning.100}"/>
    </Style>

    <Style x:Key="Badge.Danger" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Danger.100}"/>
    </Style>

    <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Info.100}"/>
    </Style>

    <Style x:Key="Badge.Neutral" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Slate.100}"/>
    </Style>

    <!-- Legacy badge names (for backward compatibility) -->
    <Style x:Key="BadgeGreen" TargetType="Border" BasedOn="{StaticResource Badge.Success}"/>
    <Style x:Key="BadgeAmber" TargetType="Border" BasedOn="{StaticResource Badge.Warning}"/>
    <Style x:Key="BadgeRed" TargetType="Border" BasedOn="{StaticResource Badge.Danger}"/>
    <Style x:Key="BadgeBlue" TargetType="Border" BasedOn="{StaticResource Badge.Info}"/>

    <!-- ========================================== -->
    <!-- 11. INPUT STYLE (Legacy Support) -->
    <!-- ========================================== -->
    
    <Style x:Key="InputStyle" TargetType="TextBox" BasedOn="{StaticResource ModernInput}"/>

</ResourceDictionary>
